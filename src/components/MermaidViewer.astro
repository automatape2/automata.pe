---
interface Props {
    source: string;
    label?: string;
    fallback?: string;
}

const { source, label, fallback } = Astro.props;
const uid = `mv-${Math.random().toString(36).slice(2, 10)}`;
// Stable key for share URLs — derived from the label, falls back to the uid.
const shareKey = (label || uid)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 32);
---

<div class="mermaid-viewer panel" data-mermaid-viewer={uid} data-share-key={shareKey}>
    <div class="window-chrome">
        <div class="window-chrome-title">{label || "diagram.mmd"}</div>
    </div>

    <!-- Tab bar -->
    <div class="flex items-center justify-between px-3 py-2 border-b border-[var(--line)] text-xs font-mono">
        <div class="flex gap-2" role="tablist">
            <button
                type="button"
                class="tab-btn px-2.5 py-1 border border-[var(--green)] text-[var(--green)] transition-colors"
                data-tab="view"
                aria-selected="true"
            >▸ view</button>
            <button
                type="button"
                class="tab-btn px-2.5 py-1 border border-[var(--line-bright)] text-[var(--fg-muted)] hover:text-[var(--green)] hover:border-[var(--green)] transition-colors"
                data-tab="source"
                aria-selected="false"
            >▸ source</button>
        </div>
        <div class="flex items-center gap-3">
            <span class="mv-status text-[var(--fg-muted)]">loading…</span>
            <button
                type="button"
                class="share-btn text-[var(--fg-muted)] hover:text-[var(--green)] transition-colors"
                aria-label="Copy a share URL with the current source"
            >[ share ]</button>
            <button
                type="button"
                class="copy-btn text-[var(--fg-muted)] hover:text-[var(--green)] transition-colors"
            >[ copy ]</button>
        </div>
    </div>

    <!-- View pane (rendered SVG) -->
    <div class="mv-pane" data-pane="view">
        <div class="mv-svg p-4 overflow-auto bg-[var(--bg)] flex items-center justify-center min-h-[120px] max-h-[420px] relative">
            <pre class="mv-source-raw whitespace-pre font-mono text-[12px] text-[var(--fg-dim)] hidden">{source}</pre>
            <!-- Skeleton placeholders while Mermaid loads -->
            <div class="mv-skeleton" aria-hidden="true">
                <div class="mv-sk-row mv-sk-row-a"></div>
                <div class="mv-sk-row mv-sk-row-b"></div>
                <div class="mv-sk-row mv-sk-row-c"></div>
            </div>
        </div>
        {fallback && (
            <details class="border-t border-[var(--line)]">
                <summary class="px-4 py-2 cursor-pointer text-xs text-[var(--fg-muted)] hover:text-[var(--green)]">▸ ascii fallback</summary>
                <pre class="p-6 overflow-x-auto text-[12px] leading-[1.5] text-[var(--fg)] font-mono">{fallback}</pre>
            </details>
        )}
    </div>

    <!-- Source pane (editable code editor) -->
    <div class="mv-pane hidden" data-pane="source">
        <textarea
            class="mv-source-editor block w-full p-6 bg-transparent border-0 outline-none resize-y font-mono text-[12.5px] leading-[1.6] text-[var(--fg)] whitespace-pre"
            spellcheck="false"
            aria-label="Edit Mermaid source"
        >{source}</textarea>
        <div class="mv-edit-footer hidden border-t border-[var(--line)] px-4 py-2 text-[11px] text-[var(--fg-muted)] flex items-center justify-between">
            <span><span class="text-[var(--amber)]">●</span> unsaved edits — view tab will re-render</span>
            <button type="button" class="mv-edit-reset text-[var(--fg-muted)] hover:text-[var(--green)] transition-colors">[ reset ]</button>
        </div>
    </div>
</div>

<style is:global>
    /* ============ Mermaid skeleton (while loading) ============ */
    .mv-skeleton {
        display: flex;
        flex-direction: column;
        gap: 14px;
        width: min(560px, 90%);
        padding: 8px;
    }
    .mv-sk-row {
        height: 56px;
        background: linear-gradient(
            90deg,
            rgba(31, 41, 55, 0.45) 0%,
            rgba(74, 222, 128, 0.10) 50%,
            rgba(31, 41, 55, 0.45) 100%
        );
        background-size: 200% 100%;
        animation: mv-sk-pulse 1.2s ease-in-out infinite;
        border: 1px solid var(--line);
    }
    .mv-sk-row-a { width: 60%; align-self: center; }
    .mv-sk-row-b { width: 90%; }
    .mv-sk-row-c { width: 75%; align-self: flex-end; }
    @keyframes mv-sk-pulse {
        0%, 100% { background-position: 0% 0%; }
        50% { background-position: -200% 0%; }
    }
    /* Hide skeleton once an <svg> sibling has been rendered into the container */
    .mv-svg:has(svg) .mv-skeleton { display: none; }

    /* ============ Editable Mermaid source textarea ============ */
    .mv-source-editor {
        min-height: 240px;
        caret-color: var(--green);
        tab-size: 4;
    }
    .mv-source-editor:focus { outline: none; box-shadow: inset 2px 0 0 var(--green); }

    /* ============ Mermaid size cap — diagrams render at natural size; constrain proportionally ============ */
    .mv-svg svg {
        max-width: min(100%, 720px) !important;
        max-height: 380px !important;
        width: auto !important;
        height: auto !important;
        display: block;
        margin: 0 auto;
    }

    /* ============ Mermaid C4 — remap inline fills/strokes to terminal palette ============ */
    /* Mermaid C4 paints colors as inline SVG attributes (not classes), so we target the
       known default fills/strokes and remap them. */

    /* Person (fill #08427B / stroke #073B6F)  →  panel + green */
    .mv-svg svg rect[fill="#08427B"],
    .mv-svg svg path[fill="#08427B"] { fill: #0D1117 !important; stroke: #4ADE80 !important; }
    .mv-svg svg [stroke="#073B6F"] { stroke: #4ADE80 !important; }

    /* System (fill #1168BD)  →  panel + cyan */
    .mv-svg svg rect[fill="#1168BD"],
    .mv-svg svg path[fill="#1168BD"] { fill: #0D1117 !important; stroke: #06B6D4 !important; }

    /* Container (fill #438DD5)  →  panel + cyan */
    .mv-svg svg rect[fill="#438DD5"],
    .mv-svg svg path[fill="#438DD5"] { fill: #0D1117 !important; stroke: #06B6D4 !important; }
    .mv-svg svg [stroke="#3C7FC0"] { stroke: #06B6D4 !important; }

    /* Component (fill #85BBF0)  →  panel + green */
    .mv-svg svg rect[fill="#85BBF0"],
    .mv-svg svg path[fill="#85BBF0"] { fill: #0D1117 !important; stroke: #4ADE80 !important; }
    .mv-svg svg [stroke="#78A8D8"] { stroke: #4ADE80 !important; }

    /* External (fill #999999 / stroke #8A8A8A)  →  dim panel + muted */
    .mv-svg svg rect[fill="#999999"],
    .mv-svg svg path[fill="#999999"] { fill: #111827 !important; stroke: #6B7280 !important; }
    .mv-svg svg [stroke="#8A8A8A"] { stroke: #6B7280 !important; }

    /* Relation labels (text fill #444444)  →  muted text */
    .mv-svg svg text[fill="#444444"] { fill: #9CA3AF !important; }

    /* Relation arrows / icon strokes (#444444, black)  →  muted line */
    .mv-svg svg path[stroke="#444444"],
    .mv-svg svg path[stroke="#000000"],
    .mv-svg svg line[stroke="#444444"],
    .mv-svg svg line[stroke="#000000"] { stroke: #6B7280 !important; }

    /* Person icon body (filled black) — keep visible on dark bg */
    .mv-svg svg .person-man path[fill="black"] { fill: #4ADE80 !important; }

    /* Title and footer text */
    .mv-svg svg text { fill: #E5E7EB; }
    /* "<<system>>" / "<<person>>" stereotype labels above shapes — make them subtle */
    .mv-svg svg text[font-style="italic"] {
        fill: #9CA3AF !important;
        opacity: 0.7;
        font-size: 10px !important;
        text-transform: lowercase;
    }

    /* Flowchart node defaults (used in infrastructure diagrams) */
    .mv-svg svg .node rect,
    .mv-svg svg .node polygon,
    .mv-svg svg .node circle,
    .mv-svg svg .node path,
    .mv-svg svg .node .label-container {
        fill: #0D1117 !important;
        stroke: #4ADE80 !important;
    }
    .mv-svg svg .node.ext rect,
    .mv-svg svg .node.ext .label-container { stroke: #6B7280 !important; fill: #111827 !important; }
    .mv-svg svg .node.db rect,
    .mv-svg svg .node.db path,
    .mv-svg svg .node.db .label-container { stroke: #06B6D4 !important; }
    .mv-svg svg .node.edge rect,
    .mv-svg svg .node.edge .label-container { stroke: #4ADE80 !important; }

    /* Flowchart edges */
    .mv-svg svg .flowchart-link,
    .mv-svg svg .edge-thickness-normal {
        stroke: #6B7280 !important;
        stroke-width: 1.5px !important;
    }
    .mv-svg svg .marker { fill: #6B7280 !important; stroke: #6B7280 !important; }
    .mv-svg svg .edgeLabel { background: #0A0A0A !important; color: #9CA3AF !important; }
    .mv-svg svg .edgeLabel foreignObject > div,
    .mv-svg svg .edgeLabel rect { background-color: #000 !important; color: #9CA3AF !important; }
</style>

<script>
    // Lazy-load mermaid from CDN (ESM build). Only ships when a viewer is on the page.
    let mermaidPromise: Promise<any> | null = null;

    function loadMermaid() {
        if (!mermaidPromise) {
            mermaidPromise = (async () => {
                // @ts-ignore — runtime ESM import
                const mod = await import("https://esm.sh/mermaid@11.4.1");
                const m = mod.default;
                m.initialize({
                    startOnLoad: false,
                    theme: "base",
                    // Sans-serif for diagrams: monospace ligatures + ss02/ss03 mangle SVG text
                    fontFamily: "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
                    securityLevel: "strict",
                    themeVariables: {
                        background: "#000000",
                        primaryColor: "#0D1117",
                        primaryTextColor: "#E5E7EB",
                        primaryBorderColor: "#4ADE80",
                        secondaryColor: "#111827",
                        tertiaryColor: "#0A0A0A",
                        lineColor: "#9CA3AF",
                        textColor: "#E5E7EB",
                    },
                    c4: {
                        // C4 has its own palette layer; keep boxes terminal-themed
                        diagramMarginX: 32,
                        diagramMarginY: 16,
                        c4ShapeMargin: 40,
                        c4ShapePadding: 16,
                    },
                    themeCSS: `
                        .person, .external_person { fill: #0D1117 !important; stroke: #4ADE80 !important; }
                        .external_person { stroke: #6B7280 !important; opacity: 0.85; }
                        .system, .system_db, .system_queue { fill: #0D1117 !important; stroke: #06B6D4 !important; }
                        .external_system, .external_system_db, .external_system_queue { fill: #111827 !important; stroke: #6B7280 !important; }
                        .container, .container_db, .container_queue { fill: #0D1117 !important; stroke: #06B6D4 !important; }
                        .external_container, .external_container_db, .external_container_queue { fill: #111827 !important; stroke: #6B7280 !important; }
                        .component, .component_db, .component_queue { fill: #0D1117 !important; stroke: #4ADE80 !important; }
                        .external_component { fill: #111827 !important; stroke: #6B7280 !important; }
                        .boundary { fill: rgba(74, 222, 128, 0.03) !important; stroke: #4ADE80 !important; stroke-dasharray: 4 4 !important; }
                        text { fill: #E5E7EB !important; font-feature-settings: normal !important; font-variant: normal !important; }
                        .person tspan, .system tspan, .container tspan, .component tspan { fill: #E5E7EB !important; }
                        .external_person tspan, .external_system tspan, .external_container tspan { fill: #9CA3AF !important; }
                        .relation, .rel, .relation_label { stroke: #6B7280 !important; }
                        .relation_label tspan { fill: #9CA3AF !important; }
                        .legend { fill: #0A0A0A !important; stroke: #374151 !important; }
                    `,
                });
                return m;
            })();
        }
        return mermaidPromise;
    }

    async function renderViewer(viewer: HTMLElement, codeOverride?: string) {
        const sourceEl = viewer.querySelector(".mv-source-raw") as HTMLElement | null;
        const svgContainer = viewer.querySelector(".mv-svg") as HTMLElement | null;
        const status = viewer.querySelector(".mv-status") as HTMLElement | null;
        if (!svgContainer) return;

        const code = codeOverride ?? sourceEl?.textContent ?? "";
        try {
            const mermaid = await loadMermaid();
            const id = `mermaid-${Math.random().toString(36).slice(2, 10)}`;
            const { svg } = await mermaid.render(id, code);
            svgContainer.innerHTML = svg;
            if (status) {
                status.textContent = "rendered";
                status.classList.remove("text-[var(--fg-muted)]", "text-[var(--amber)]");
                status.classList.add("text-[var(--green)]");
            }
        } catch (err) {
            console.error("[MermaidViewer] render failed:", err);
            if (status) {
                status.textContent = "render error";
                status.classList.remove("text-[var(--fg-muted)]", "text-[var(--green)]");
                status.classList.add("text-[var(--amber)]");
            }
        }
    }

    function wireUp(viewer: HTMLElement) {
        const tabs = viewer.querySelectorAll<HTMLButtonElement>(".tab-btn");
        const panes = viewer.querySelectorAll<HTMLElement>(".mv-pane");

        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const target = tab.getAttribute("data-tab");
                tabs.forEach((t) => {
                    const active = t === tab;
                    t.setAttribute("aria-selected", String(active));
                    if (active) {
                        t.classList.remove("text-[var(--fg-muted)]", "border-[var(--line-bright)]");
                        t.classList.add("text-[var(--green)]", "border-[var(--green)]");
                    } else {
                        t.classList.remove("text-[var(--green)]", "border-[var(--green)]");
                        t.classList.add("text-[var(--fg-muted)]", "border-[var(--line-bright)]");
                    }
                });
                panes.forEach((p) => {
                    p.classList.toggle("hidden", p.getAttribute("data-pane") !== target);
                });
            });
        });

        const copyBtn = viewer.querySelector(".copy-btn") as HTMLButtonElement | null;
        copyBtn?.addEventListener("click", async () => {
            const editor = viewer.querySelector<HTMLTextAreaElement>(".mv-source-editor");
            const text = editor?.value ?? viewer.querySelector(".mv-source-raw")?.textContent ?? "";
            try {
                await navigator.clipboard.writeText(text);
                copyBtn.textContent = "[ copied ]";
                setTimeout(() => { copyBtn.textContent = "[ copy ]"; }, 1500);
            } catch {
                copyBtn.textContent = "[ failed ]";
                setTimeout(() => { copyBtn.textContent = "[ copy ]"; }, 1500);
            }
        });

        // ============ Share ============
        // Encode current source into ?d=<key>:<base64> and copy the URL.
        const shareBtn = viewer.querySelector(".share-btn") as HTMLButtonElement | null;
        const viewerKey = viewer.getAttribute("data-share-key") || "";
        function utf8ToB64(s: string): string {
            return btoa(unescape(encodeURIComponent(s)))
                .replace(/\+/g, "-")
                .replace(/\//g, "_")
                .replace(/=+$/, "");
        }
        function b64ToUtf8(s: string): string {
            const padded = s.replace(/-/g, "+").replace(/_/g, "/");
            const pad = padded.length % 4 ? "=".repeat(4 - (padded.length % 4)) : "";
            return decodeURIComponent(escape(atob(padded + pad)));
        }
        shareBtn?.addEventListener("click", async () => {
            const editor = viewer.querySelector<HTMLTextAreaElement>(".mv-source-editor");
            const text = editor?.value ?? viewer.querySelector(".mv-source-raw")?.textContent ?? "";
            const encoded = utf8ToB64(text);
            const u = new URL(window.location.href);
            u.searchParams.set("d", `${viewerKey}:${encoded}`);
            try {
                await navigator.clipboard.writeText(u.toString());
                history.replaceState(null, "", u.toString());
                shareBtn.textContent = "[ url copied ]";
                shareBtn.classList.add("text-[var(--green)]");
                setTimeout(() => {
                    shareBtn.textContent = "[ share ]";
                    shareBtn.classList.remove("text-[var(--green)]");
                }, 1800);
            } catch {
                shareBtn.textContent = "[ failed ]";
                setTimeout(() => { shareBtn.textContent = "[ share ]"; }, 1500);
            }
        });

        // On first load, if ?d=<key>:<source> matches this viewer, apply the shared source.
        try {
            const param = new URL(window.location.href).searchParams.get("d");
            if (param && viewerKey) {
                const sepIdx = param.indexOf(":");
                if (sepIdx > 0) {
                    const k = param.slice(0, sepIdx);
                    const src = param.slice(sepIdx + 1);
                    if (k === viewerKey) {
                        const editor = viewer.querySelector<HTMLTextAreaElement>(".mv-source-editor");
                        const decoded = b64ToUtf8(src);
                        if (editor) editor.value = decoded;
                        const sourceRaw = viewer.querySelector(".mv-source-raw");
                        if (sourceRaw) sourceRaw.textContent = decoded;
                        // surface the dirty footer so the user knows it's a shared variant
                        viewer.querySelector(".mv-edit-footer")?.classList.remove("hidden");
                    }
                }
            }
        } catch (e) {
            console.warn("[MermaidViewer] failed to apply ?d param:", e);
        }

        // Editable source: debounce edits, re-render view, expose reset
        const editor = viewer.querySelector<HTMLTextAreaElement>(".mv-source-editor");
        const editFooter = viewer.querySelector<HTMLElement>(".mv-edit-footer");
        const resetBtn = viewer.querySelector<HTMLButtonElement>(".mv-edit-reset");
        const originalSrc = editor?.value ?? "";
        let timer: number | null = null;

        editor?.addEventListener("input", () => {
            if (editFooter) editFooter.classList.remove("hidden");
            if (timer) window.clearTimeout(timer);
            timer = window.setTimeout(() => {
                renderViewer(viewer, editor.value);
            }, 400);
        });

        resetBtn?.addEventListener("click", () => {
            if (!editor) return;
            editor.value = originalSrc;
            editFooter?.classList.add("hidden");
            renderViewer(viewer, originalSrc);
        });

        // Initial render
        renderViewer(viewer);
    }

    document.querySelectorAll<HTMLElement>("[data-mermaid-viewer]").forEach(wireUp);
</script>
