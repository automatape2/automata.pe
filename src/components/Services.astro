---
interface ServiceItem {
    name: string;
    description: string;
    icon: string;
    gradient: string;
}

interface Props {
    t: {
        sectionTitle: string;
        subtitle: string;
        items: ServiceItem[];
    };
}

const { t } = Astro.props;
---

<section id="services" class="py-24 scroll-mt-16">
    <div class="flex items-end justify-between gap-6 mb-10 border-b border-[var(--line)] pb-6" data-animate="fade-up">
        <div>
            <div class="text-xs text-[var(--fg-muted)] mb-2">// section 02</div>
            <h2 class="heading-mono text-[clamp(1.75rem,4vw,2.75rem)]">
                <span class="text-[var(--green)]">$</span> ls ./{t.sectionTitle.toLowerCase()}
            </h2>
            <p class="mt-3 text-sm md:text-[15px] text-[var(--fg-dim)] max-w-2xl">
                <span class="text-[var(--fg-muted)]">// </span>{t.subtitle}
            </p>
        </div>
        <div class="hidden md:block text-right text-xs text-[var(--fg-muted)] font-mono">
            <div>{t.items.length} modules</div>
            <div class="text-[var(--green)]">all ready</div>
        </div>
    </div>

    <div data-stagger="0.05">
        {
            t.items.map((service, i) => (
                <div class="row-inverter group">
                    <div class="row-index">{String(i + 1).padStart(2, '0')}</div>
                    <div>
                        <div class="flex items-start justify-between gap-6">
                            <div class="row-title">
                                <span class="text-[var(--green)] group-hover:text-black mr-2">▸</span>
                                {service.name}
                            </div>
                            <span class="row-arrow shrink-0 mt-1">→</span>
                        </div>
                        <p class="row-desc">{service.description}</p>
                    </div>
                </div>
            ))
        }
    </div>
</section>
