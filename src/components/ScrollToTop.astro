---
---

<button
    id="scroll-to-top"
    class="fixed bottom-6 right-6 w-11 h-11 bg-black border border-[var(--line-bright)] text-[var(--fg-dim)] hover:border-[var(--green)] hover:text-[var(--green)] hover:bg-[var(--green)]/5 flex items-center justify-center opacity-0 pointer-events-none transition-all duration-200 z-40 font-mono text-sm"
    aria-label="Scroll to top"
    title="cd /"
>
    <span class="leading-none">▲</span>
</button>

<script>
    const scrollToTopBtn = document.getElementById("scroll-to-top");

    window.addEventListener("scroll", () => {
        if (window.pageYOffset > 300) {
            scrollToTopBtn?.classList.remove("opacity-0", "pointer-events-none");
            scrollToTopBtn?.classList.add("opacity-100", "pointer-events-auto");
        } else {
            scrollToTopBtn?.classList.add("opacity-0", "pointer-events-none");
            scrollToTopBtn?.classList.remove("opacity-100", "pointer-events-auto");
        }
    });

    scrollToTopBtn?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
    });
</script>
