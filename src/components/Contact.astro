---
import { personalInfo } from "../config/personal";

interface Props {
    t: {
        title: string;
        description: string;
        email: string;
        emailLabel: string;
        ctaLabel: string;
        socialLabel: string;
    };
}

const { t } = Astro.props;
---

<section id="contact" class="py-24 scroll-mt-16">
    <div class="border-b border-[var(--line)] pb-6 mb-10" data-animate="fade-up">
        <div class="text-xs text-[var(--fg-muted)] mb-2">// section 04</div>
        <h2 class="heading-mono text-[clamp(1.75rem,4vw,2.75rem)]">
            <span class="text-[var(--green)]">$</span> ./contact.sh
        </h2>
        <p class="mt-3 text-sm md:text-[15px] text-[var(--fg-dim)] max-w-2xl">
            <span class="text-[var(--fg-muted)]">// </span>{t.description}
        </p>
    </div>

    <div class="grid lg:grid-cols-[1.2fr_1fr] gap-0 border border-[var(--line)]">
        <!-- Left: terminal CTA -->
        <div class="panel border-0 p-8 md:p-10" data-animate="fade-right">
            <div class="text-xs text-[var(--fg-muted)] mb-6">automata@latam: ~/connect</div>

            <div class="font-mono text-sm space-y-2 mb-8">
                <div><span class="text-[var(--green)]">$</span> echo "ready to ship"</div>
                <div class="text-[var(--fg-dim)]">→ <span class="text-[var(--fg)]">{t.title}</span></div>
                <div class="pt-2">
                    <span class="text-[var(--green)]">$</span> contact --email
                </div>
                <a href={`mailto:${t.email}`} class="block link-mono text-[var(--green)] text-base md:text-lg break-all pt-1">
                    {t.email}
                </a>
            </div>

            <div class="flex flex-wrap gap-3 pt-4">
                <a href={`mailto:${t.email}?subject=Demo%20Request`} class="btn-cli btn-cli--primary">
                    <span>./{t.ctaLabel.toLowerCase().replace(/\s+/g,'-')}.sh</span>
                </a>
                <a href={`mailto:${t.email}`} class="btn-cli">
                    <span>mail --send</span>
                </a>
            </div>
        </div>

        <!-- Right: socials as file listing -->
        <div class="panel border-0 border-t lg:border-t-0 lg:border-l border-[var(--line)] p-8 md:p-10" data-animate="fade-left">
            <div class="text-xs text-[var(--fg-muted)] mb-6">// {t.socialLabel.toLowerCase()}</div>

            <ul class="space-y-1 font-mono text-sm">
                <li>
                    <a href={personalInfo.socialLinks.github} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between py-3 border-b border-[var(--line)] text-[var(--fg)] hover:text-[var(--green)] hover:pl-2 transition-all group/social">
                        <span class="flex items-center gap-3">
                            <span class="text-[var(--fg-muted)] group-hover/social:text-[var(--green)]">▸</span>
                            <span>github.com/<span class="text-[var(--fg-dim)] group-hover/social:text-[var(--green)]">{personalInfo.socialUsernames.github}</span></span>
                        </span>
                        <span class="text-[var(--fg-muted)] group-hover/social:text-[var(--green)] group-hover/social:translate-x-1 transition-transform">→</span>
                    </a>
                </li>
                <li>
                    <a href={personalInfo.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between py-3 border-b border-[var(--line)] text-[var(--fg)] hover:text-[var(--green)] hover:pl-2 transition-all group/social">
                        <span class="flex items-center gap-3">
                            <span class="text-[var(--fg-muted)] group-hover/social:text-[var(--green)]">▸</span>
                            <span>linkedin.com/company/<span class="text-[var(--fg-dim)] group-hover/social:text-[var(--green)]">{personalInfo.socialUsernames.linkedin}</span></span>
                        </span>
                        <span class="text-[var(--fg-muted)] group-hover/social:text-[var(--green)] group-hover/social:translate-x-1 transition-transform">→</span>
                    </a>
                </li>
                <li>
                    <a href={personalInfo.socialLinks.twitter} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between py-3 text-[var(--fg)] hover:text-[var(--green)] hover:pl-2 transition-all group/social">
                        <span class="flex items-center gap-3">
                            <span class="text-[var(--fg-muted)] group-hover/social:text-[var(--green)]">▸</span>
                            <span>x.com/<span class="text-[var(--fg-dim)] group-hover/social:text-[var(--green)]">{personalInfo.socialUsernames.twitter.replace('@','')}</span></span>
                        </span>
                        <span class="text-[var(--fg-muted)] group-hover/social:text-[var(--green)] group-hover/social:translate-x-1 transition-transform">→</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</section>
