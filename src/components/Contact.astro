---
import { personalInfo } from "../config/personal";

interface Props {
    t: {
        title: string;
        description: string;
        email: string;
        emailLabel: string;
        ctaLabel: string;
        socialLabel: string;
    };
}

const { t } = Astro.props;

// Configure these via env in production. Keeping them inline as placeholders
// so the form is functional immediately once the endpoint is set up.
const FORMSPREE_ID = import.meta.env.PUBLIC_FORMSPREE_ID || "your-form-id";
const FORM_ACTION = `https://formspree.io/f/${FORMSPREE_ID}`;
const CAL_LINK = import.meta.env.PUBLIC_CAL_LINK || "https://cal.com/automata-pe/intro";
---

<section id="contact" class="py-24 scroll-mt-16">
    <div class="border-b border-[var(--line)] pb-6 mb-10" data-animate="fade-up">
        <div class="text-xs text-[var(--fg-muted)] mb-2">// section 04</div>
        <h2 class="heading-mono text-[clamp(1.75rem,4vw,2.75rem)]">
            <span class="text-[var(--green)]">$</span> ./contact.sh
        </h2>
        <p class="mt-3 text-sm md:text-[15px] text-[var(--fg-dim)] max-w-2xl">
            <span class="text-[var(--fg-muted)]">// </span>{t.description}
        </p>
    </div>

    <div class="grid lg:grid-cols-[1.3fr_1fr] gap-0 border border-[var(--line)]">
        <!-- Left: form + Cal -->
        <div class="panel border-0 p-6 md:p-10" data-animate="fade-right">
            <div class="text-xs text-[var(--fg-muted)] mb-4">automata@latam: ~/connect</div>

            <div class="font-mono text-sm space-y-1 mb-6">
                <div><span class="text-[var(--green)]">$</span> echo "{t.title}"</div>
                <div class="text-[var(--fg-dim)]">→ <span class="text-[var(--fg)]">{t.ctaLabel}</span></div>
            </div>

            <form
                action={FORM_ACTION}
                method="POST"
                class="space-y-4 font-mono text-sm"
                data-contact-form
            >
                <label class="block">
                    <span class="block text-[10px] text-[var(--fg-muted)] uppercase tracking-[0.15em] mb-1.5">▸ name</span>
                    <input
                        type="text"
                        name="name"
                        required
                        autocomplete="name"
                        class="form-input"
                        placeholder="Jane Doe"
                    />
                </label>

                <label class="block">
                    <span class="block text-[10px] text-[var(--fg-muted)] uppercase tracking-[0.15em] mb-1.5">▸ email</span>
                    <input
                        type="email"
                        name="email"
                        required
                        autocomplete="email"
                        class="form-input"
                        placeholder="jane@company.com"
                    />
                </label>

                <label class="block">
                    <span class="block text-[10px] text-[var(--fg-muted)] uppercase tracking-[0.15em] mb-1.5">▸ message</span>
                    <textarea
                        name="message"
                        required
                        rows="4"
                        class="form-input resize-y"
                        placeholder="What are you building?"
                    ></textarea>
                </label>

                <!-- Honeypot for bots -->
                <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" />

                <div class="flex flex-wrap items-center gap-3 pt-2">
                    <button type="submit" class="btn-cli btn-cli--primary">
                        <span>./send.sh</span>
                    </button>
                    <a href={CAL_LINK} target="_blank" rel="noopener noreferrer" class="btn-cli inline-flex items-center gap-2">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        <span>book a call</span>
                    </a>
                    <span data-contact-status class="text-xs text-[var(--fg-muted)] ml-auto"></span>
                </div>
            </form>

            <div class="mt-6 pt-5 border-t border-[var(--line)] text-xs text-[var(--fg-muted)]">
                <span class="text-[var(--fg-muted)]">// or email directly: </span>
                <a href={`mailto:${t.email}`} class="link-mono text-[var(--green)] break-all">{t.email}</a>
            </div>
        </div>

        <!-- Right: socials -->
        <div class="panel border-0 border-t lg:border-t-0 lg:border-l border-[var(--line)] p-6 md:p-10" data-animate="fade-left">
            <div class="text-xs text-[var(--fg-muted)] mb-6">// {t.socialLabel.toLowerCase()}</div>

            <ul class="space-y-1 font-mono text-sm">
                <li>
                    <a href={personalInfo.socialLinks.github} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between py-3 border-b border-[var(--line)] text-[var(--fg)] hover:text-[var(--green)] hover:pl-2 transition-all group/social">
                        <span class="flex items-center gap-3">
                            <span class="text-[var(--fg-muted)] group-hover/social:text-[var(--green)]">▸</span>
                            <span>github.com/<span class="text-[var(--fg-dim)] group-hover/social:text-[var(--green)]">{personalInfo.socialUsernames.github}</span></span>
                        </span>
                        <span class="text-[var(--fg-muted)] group-hover/social:text-[var(--green)] group-hover/social:translate-x-1 transition-transform">→</span>
                    </a>
                </li>
                <li>
                    <a href={personalInfo.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between py-3 border-b border-[var(--line)] text-[var(--fg)] hover:text-[var(--green)] hover:pl-2 transition-all group/social">
                        <span class="flex items-center gap-3">
                            <span class="text-[var(--fg-muted)] group-hover/social:text-[var(--green)]">▸</span>
                            <span>linkedin.com/company/<span class="text-[var(--fg-dim)] group-hover/social:text-[var(--green)]">{personalInfo.socialUsernames.linkedin}</span></span>
                        </span>
                        <span class="text-[var(--fg-muted)] group-hover/social:text-[var(--green)] group-hover/social:translate-x-1 transition-transform">→</span>
                    </a>
                </li>
                <li>
                    <a href={personalInfo.socialLinks.twitter} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between py-3 text-[var(--fg)] hover:text-[var(--green)] hover:pl-2 transition-all group/social">
                        <span class="flex items-center gap-3">
                            <span class="text-[var(--fg-muted)] group-hover/social:text-[var(--green)]">▸</span>
                            <span>x.com/<span class="text-[var(--fg-dim)] group-hover/social:text-[var(--green)]">{personalInfo.socialUsernames.twitter.replace('@','')}</span></span>
                        </span>
                        <span class="text-[var(--fg-muted)] group-hover/social:text-[var(--green)] group-hover/social:translate-x-1 transition-transform">→</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</section>

<style is:global>
    .form-input {
        display: block;
        width: 100%;
        padding: 10px 12px;
        background: var(--bg-elev);
        color: var(--fg);
        border: 1px solid var(--line-bright);
        font-family: inherit;
        font-size: 14px;
        outline: none;
        transition: border-color 120ms;
    }
    .form-input::placeholder { color: var(--fg-muted); }
    .form-input:focus { border-color: var(--green); box-shadow: 0 0 0 1px var(--green); }
</style>

<script>
    document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
        const status = form.querySelector<HTMLElement>("[data-contact-status]");
        const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (!status || !submit) return;
            status.textContent = "sending…";
            status.classList.remove("text-[var(--green)]", "text-[var(--red)]");
            submit.disabled = true;
            try {
                const res = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form),
                    headers: { Accept: "application/json" },
                });
                if (res.ok) {
                    status.textContent = "✓ sent — we'll reply within 24h";
                    status.classList.add("text-[var(--green)]");
                    form.reset();
                } else {
                    throw new Error(String(res.status));
                }
            } catch {
                status.textContent = "✗ couldn't send — try email instead";
                status.classList.add("text-[var(--red)]");
            } finally {
                submit.disabled = false;
            }
        });
    });
</script>
