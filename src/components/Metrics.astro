---
interface MetricItem {
    value: string;
    label: string;
}

interface Props {
    t: {
        sectionTitle: string;
        subtitle: string;
        items: MetricItem[];
    };
}

const { t } = Astro.props;
---

<section id="metrics" class="py-24 border-y border-[var(--line)] bg-[var(--bg-elev)]/40 scroll-mt-16">
    <div class="container mx-auto px-6 lg:px-12 max-w-7xl">
        <div class="flex items-end justify-between gap-6 mb-10" data-animate="fade-up">
            <div>
                <div class="text-xs text-[var(--fg-muted)] mb-2">// metrics --json</div>
                <h2 class="heading-mono text-[clamp(1.75rem,4vw,2.75rem)]">
                    <span class="text-[var(--green)]">$</span> {t.sectionTitle.toLowerCase()}
                </h2>
                <p class="mt-3 text-sm md:text-[15px] text-[var(--fg-dim)] max-w-2xl">
                    <span class="text-[var(--fg-muted)]">// </span>{t.subtitle}
                </p>
            </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-0 border border-[var(--line)]" data-stagger="0.08">
            {
                t.items.map((metric, index) => (
                    <div class={`p-8 group transition-colors hover:bg-black ${index > 0 ? 'border-l border-[var(--line)]' : ''} ${index === 2 ? 'border-t lg:border-t-0 lg:border-l' : ''} ${index === 3 ? 'border-t lg:border-t-0' : ''} ${index === 2 ? 'border-l-0 lg:border-l' : ''}`}>
                        <div class="flex items-baseline gap-2 mb-3">
                            <span class="text-[var(--green)] text-xs">{String(index + 1).padStart(2, '0')}</span>
                            <span class="text-[var(--line-bright)] text-xs">/</span>
                        </div>
                        <div class="heading-mono text-[clamp(2.25rem,5vw,3.5rem)] text-[var(--fg)] group-hover:text-[var(--green)] transition-colors leading-none">
                            {metric.value}
                        </div>
                        <div class="mt-3 text-[11px] text-[var(--fg-muted)] uppercase tracking-[0.15em]">
                            {metric.label}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
