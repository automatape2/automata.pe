---
import { getLangFromUrl, getTranslations } from "../i18n/utils";
import { personalInfo } from "../config/personal";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const homeHref = lang === "es" ? "/" : "/en";
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--line)] bg-[var(--bg-elev)]/30 mt-16">
    <div class="container mx-auto px-6 lg:px-12 max-w-7xl py-12">
        <!-- ASCII top -->
        <div class="text-[var(--fg-muted)] font-mono text-[11px] mb-8 overflow-hidden whitespace-nowrap select-none">
            <span class="text-[var(--green)]">$</span> echo &quot;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&quot;
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
            <div class="md:col-span-2 space-y-3">
                <a href={homeHref} class="text-sm group inline-flex items-center gap-2">
                    <span class="text-[var(--green)]">$</span>
                    <span class="text-[var(--fg)] font-bold group-hover:text-[var(--green)] transition-colors">{personalInfo.brandName.toLowerCase()}</span>
                </a>
                <p class="text-[var(--fg-muted)] text-xs max-w-md leading-relaxed">
                    <span class="text-[var(--fg-muted)]">// </span>{t.footer.tagline}
                </p>
            </div>

            <div>
                <h3 class="text-[11px] uppercase tracking-[0.15em] text-[var(--fg-muted)] mb-4">▸ {t.footer.quickLinks}</h3>
                <ul class="space-y-2 text-sm">
                    <li><a href="#services" class="link-mono text-[var(--fg-dim)]">{t.nav.services}</a></li>
                    <li><a href="#solutions" class="link-mono text-[var(--fg-dim)]">{t.nav.solutions}</a></li>
                    <li><a href="#tech" class="link-mono text-[var(--fg-dim)]">{t.nav.tech}</a></li>
                    <li><a href="#contact" class="link-mono text-[var(--fg-dim)]">{t.nav.contact}</a></li>
                </ul>
            </div>

            <div>
                <h3 class="text-[11px] uppercase tracking-[0.15em] text-[var(--fg-muted)] mb-4">▸ {t.footer.socialTitle}</h3>
                <ul class="space-y-2 text-sm">
                    <li><a href={personalInfo.socialLinks.github} target="_blank" rel="noopener noreferrer" class="link-mono text-[var(--fg-dim)]">github</a></li>
                    <li><a href={personalInfo.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="link-mono text-[var(--fg-dim)]">linkedin</a></li>
                    <li><a href={personalInfo.socialLinks.twitter} target="_blank" rel="noopener noreferrer" class="link-mono text-[var(--fg-dim)]">x.com</a></li>
                    <li><a href={`mailto:${t.contact.email}`} class="link-mono text-[var(--fg-dim)]">{t.contact.email}</a></li>
                </ul>
            </div>
        </div>

        <div class="pt-6 border-t border-[var(--line)] flex flex-col md:flex-row justify-between gap-3 text-xs text-[var(--fg-muted)]">
            <p>
                <span class="text-[var(--green)]">●</span> {year} {t.footer.copyright}
            </p>
            <div class="flex gap-5">
                <a href="#" class="link-mono">{t.footer.privacy}</a>
                <a href="#" class="link-mono">{t.footer.terms}</a>
            </div>
        </div>
    </div>
</footer>
