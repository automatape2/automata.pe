---
interface Category {
    name: string;
    items: string[];
}

interface Props {
    t: {
        sectionTitle: string;
        subtitle: string;
        categories: Category[];
    };
}

const { t } = Astro.props;

// Flatten for marquee
const allItems = t.categories.flatMap(c => c.items);
---

<section id="tech" class="py-24 scroll-mt-16">
    <div class="flex items-end justify-between gap-6 mb-10 border-b border-[var(--line)] pb-6" data-animate="fade-up">
        <div>
            <div class="text-xs text-[var(--fg-muted)] mb-2">// section 03</div>
            <h2 class="heading-mono text-[clamp(1.75rem,4vw,2.75rem)]">
                <span class="text-[var(--green)]">$</span> stack --list
            </h2>
            <p class="mt-3 text-sm md:text-[15px] text-[var(--fg-dim)] max-w-2xl">
                <span class="text-[var(--fg-muted)]">// </span>{t.subtitle}
            </p>
        </div>
        <div class="hidden md:block text-right text-xs text-[var(--fg-muted)] font-mono">
            <div>{allItems.length} packages</div>
            <div class="text-[var(--green)]">installed</div>
        </div>
    </div>

    <!-- Marquee strip -->
    <div class="overflow-hidden border-y border-[var(--line)] py-4 mb-12 bg-[var(--bg-elev)]/40">
        <div class="marquee gap-8 text-sm text-[var(--fg-muted)]">
            {[...allItems, ...allItems].map((tech) => (
                <span class="flex items-center gap-3 whitespace-nowrap">
                    <span class="text-[var(--green)]">·</span>
                    <span>{tech}</span>
                </span>
            ))}
        </div>
    </div>

    <!-- Categories grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-0 border border-[var(--line)]" data-stagger="0.06">
        {
            t.categories.map((category, ci) => (
                <div class={`panel border-0 p-6 ${ci > 0 ? 'border-t lg:border-t-0 lg:border-l border-[var(--line)]' : ''} ${ci === 1 ? 'md:border-t-0 md:border-l' : ''} ${ci === 2 ? 'md:border-l-0 lg:border-l' : ''} ${ci === 3 ? 'md:border-l' : ''}`}>
                    <div class="flex items-center gap-2 mb-5">
                        <span class="text-[var(--green)] text-xs">▸</span>
                        <h3 class="text-[13px] uppercase tracking-[0.12em] text-[var(--fg-dim)] font-semibold">
                            {category.name}
                        </h3>
                    </div>
                    <ul class="space-y-2.5">
                        {category.items.map((tech, ti) => (
                            <li class="flex items-center gap-3 text-sm text-[var(--fg)] hover:text-[var(--green)] transition-colors group/item">
                                <span class="text-[var(--fg-muted)] text-xs font-mono tabular-nums shrink-0">
                                    {String(ti + 1).padStart(2, '0')}
                                </span>
                                <span class="text-[var(--line-bright)] group-hover/item:text-[var(--green)] transition-colors">·</span>
                                <span>{tech}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>
</section>
