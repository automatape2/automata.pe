---
import { Image } from "astro:assets";

interface SolutionItem {
    slug: string;
    title: string;
    description: string;
    tech: string[];
    image: ImageMetadata;
    demoUrl?: string;
    type: "producto" | "product" | "caso" | "case";
}

interface Props {
    t: {
        sectionTitle: string;
        subtitle: string;
        items: SolutionItem[];
    };
}

const { t } = Astro.props;

const typeLabels: Record<string, { es: string; en: string }> = {
    producto: { es: "Producto", en: "Product" },
    product: { es: "Producto", en: "Product" },
    caso: { es: "Caso de Uso", en: "Use Case" },
    case: { es: "Caso de Uso", en: "Use Case" }
};
---

<section id="solutions" class="py-24 scroll-mt-16">
    <div class="flex items-end justify-between gap-6 mb-10 border-b border-[var(--line)] pb-6" data-animate="fade-up">
        <div>
            <div class="text-xs text-[var(--fg-muted)] mb-2">// section 02</div>
            <h2 class="heading-mono text-[clamp(1.75rem,4vw,2.75rem)]">
                <span class="text-[var(--green)]">$</span> cat ./{t.sectionTitle.toLowerCase().replace(/\s+/g,'-')}.log
            </h2>
            <p class="mt-3 text-sm md:text-[15px] text-[var(--fg-dim)] max-w-2xl">
                <span class="text-[var(--fg-muted)]">// </span>{t.subtitle}
            </p>
        </div>
        <div class="hidden md:block text-right text-xs text-[var(--fg-muted)] font-mono">
            <div>{t.items.length} entries</div>
            <div class="text-[var(--green)]">live</div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0 border border-[var(--line)] -mt-px" data-stagger="0.06">
        {
            t.items.map((solution, index) => (
                <article class={`panel-accent group border-0 ${index % 3 !== 0 ? 'md:border-l' : ''} ${index % 2 !== 0 ? 'border-l md:border-l-0' : ''} ${index % 3 === 2 ? 'lg:border-l' : ''} border-[var(--line)] ${index >= 0 ? 'border-t' : ''} ${index < 1 ? 'border-t-0' : ''}`}>
                    <div class="aspect-[16/9] overflow-hidden border-b border-[var(--line)] relative bg-[var(--bg-elev)]">
                        <Image
                            src={solution.image}
                            alt={solution.title}
                            class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500 grayscale group-hover:grayscale-0"
                            loading="lazy"
                            width={600}
                            height={340}
                            format="webp"
                        />
                        <div class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-2 py-1 text-[10px] uppercase tracking-wider bg-black/80 backdrop-blur border border-[var(--line-bright)] text-[var(--green)]">
                            <span class="w-1 h-1 rounded-full bg-[var(--green)]"></span>
                            {typeLabels[solution.type]?.es || solution.type}
                        </div>
                    </div>
                    <div class="p-5 md:p-6 space-y-3">
                        <div class="flex items-baseline gap-3">
                            <span class="text-xs text-[var(--fg-muted)] font-mono shrink-0">{String(index + 1).padStart(2, '0')}/</span>
                            <h3 class="text-base font-semibold text-[var(--fg)] group-hover:text-[var(--green)] transition-colors leading-tight">
                                {solution.title}
                            </h3>
                        </div>
                        <p class="text-[13px] text-[var(--fg-dim)] leading-relaxed line-clamp-3">
                            {solution.description}
                        </p>
                        <div class="flex flex-wrap gap-1.5 pt-2">
                            {solution.tech.slice(0, 4).map((tech) => (
                                <span class="badge-mono">{tech}</span>
                            ))}
                            {solution.tech.length > 4 && (
                                <span class="badge-mono">+{solution.tech.length - 4}</span>
                            )}
                        </div>
                        {solution.demoUrl && (
                            <a
                                href={solution.demoUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 text-xs text-[var(--green)] hover:text-[var(--green-bright)] transition-colors pt-2"
                            >
                                <span>./open-demo</span>
                                <span class="transition-transform group-hover:translate-x-0.5">→</span>
                            </a>
                        )}
                    </div>
                </article>
            ))
        }
    </div>
</section>
