---
interface Props {
    t: {
        greeting: string;
        title: string;
        titleHighlight: string;
        titleEnd: string;
        description: string;
        cta1: string;
        cta2: string;
        socialLinks: {
            github: string;
            linkedin: string;
        };
    };
}

const { t } = Astro.props;
const stamp = new Date().toISOString().slice(0, 10);
---

<section class="min-h-[90vh] flex items-center py-16 md:py-24">
    <div class="w-full grid lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-16 items-center">

        <!-- Left: terminal prompt -->
        <div class="space-y-8">
            <div class="flex items-center gap-3 text-xs text-[var(--fg-muted)] tracking-wider">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--green)] animate-pulse"></span>
                <span>SYSTEM ONLINE</span>
                <span class="text-[var(--line-bright)]">·</span>
                <span>{stamp}</span>
                <span class="text-[var(--line-bright)]">·</span>
                <span>{t.greeting}</span>
            </div>

            <div data-animate="fade-up">
                <div class="text-sm text-[var(--green)] mb-4 font-medium">
                    <span class="text-[var(--green)]">$</span> automata --init
                </div>
                <h1 class="heading-mono text-[clamp(2.5rem,6.5vw,5.5rem)] text-[var(--fg)]">
                    <span class="block text-[var(--fg-muted)]">{'>'} {t.title.trim()}</span>
                    <span class="block text-[var(--green)] glow-green-soft cursor-blink">{t.titleHighlight}{t.titleEnd ? ` ${t.titleEnd}` : ''}</span>
                </h1>
            </div>

            <p data-animate="fade-up" data-delay="0.1" class="text-comment text-base md:text-[15px] text-[var(--fg-dim)] max-w-2xl leading-relaxed">
                {t.description}
            </p>

            <div data-animate="fade-up" data-delay="0.2" class="flex flex-wrap gap-3 pt-2">
                <a href="#solutions" class="btn-cli btn-cli--primary">
                    <span>./{t.cta1.toLowerCase().replace(/\s+/g, '-')}.sh</span>
                </a>
                <a href="#contact" class="btn-cli">
                    <span>cat ./{t.cta2.toLowerCase().replace(/\s+/g, '-')}.md</span>
                </a>
            </div>

            <!-- Social Links - terminal style -->
            <div data-animate="fade-up" data-delay="0.3" class="flex items-center gap-5 pt-4">
                <span class="text-xs text-[var(--fg-muted)]">// connect:</span>
                <a href={t.socialLinks.github} target="_blank" rel="noopener noreferrer" class="link-mono text-sm" aria-label="GitHub">github</a>
                <a href={t.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="link-mono text-sm" aria-label="LinkedIn">linkedin</a>
            </div>
        </div>

        <!-- Right: terminal window with ASCII -->
        <div data-animate="fade-left" data-delay="0.15" class="panel relative">
            <div class="window-chrome">
                <div class="window-chrome-title">automata@latam: ~/operations</div>
            </div>
            <div class="p-6 md:p-7 font-mono text-[13px] leading-[1.7] space-y-2">
                <div><span class="text-[var(--green)]">$</span> <span class="text-[var(--fg)]">automata status</span></div>
                <div class="text-[var(--fg-muted)]">[OK]  building automations for LATAM operations</div>
                <div class="text-[var(--fg-muted)]">[OK]  loading consultancy modules ............. <span class="text-[var(--green)]">ready</span></div>
                <div class="text-[var(--fg-muted)]">[OK]  software factory ........................ <span class="text-[var(--green)]">ready</span></div>
                <div class="text-[var(--fg-muted)]">[OK]  cloud + IoT infrastructure .............. <span class="text-[var(--green)]">ready</span></div>
                <div class="text-[var(--fg-muted)]">[OK]  AI workflows + automation ............... <span class="text-[var(--green)]">ready</span></div>
                <div class="text-[var(--fg-muted)]">[OK]  IT staffing ............................. <span class="text-[var(--green)]">ready</span></div>
                <div class="pt-3">
                    <span class="text-[var(--green)]">$</span> <span class="text-[var(--fg)]">automata deploy</span> <span class="text-[var(--amber)]">--your-operation</span>
                </div>
                <div class="text-[var(--fg-dim)]">→ continuity: <span class="text-[var(--green)]">guaranteed</span></div>
                <div class="text-[var(--fg-dim)]">→ stack: <span class="text-[var(--cyan)]">node · laravel · python · react</span></div>
                <div class="text-[var(--fg-dim)]">→ region: <span class="text-[var(--cyan)]">latam · global</span></div>
                <div class="pt-2 flex items-center">
                    <span class="text-[var(--green)]">$</span><span class="ml-2 cursor-blink"></span>
                </div>
            </div>

            <!-- corner ticks -->
            <div class="absolute -top-1.5 -left-1.5 w-3 h-3 border-t border-l border-[var(--green)]"></div>
            <div class="absolute -top-1.5 -right-1.5 w-3 h-3 border-t border-r border-[var(--green)]"></div>
            <div class="absolute -bottom-1.5 -left-1.5 w-3 h-3 border-b border-l border-[var(--green)]"></div>
            <div class="absolute -bottom-1.5 -right-1.5 w-3 h-3 border-b border-r border-[var(--green)]"></div>
        </div>
    </div>
</section>
