---
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

const stripped = currentPath.replace(/^\/(en|es)(?=\/|$)/, "") || "/";
const targetLang = lang === "en" ? "es" : "en";
const toggleUrl = stripped === "/" ? `/${targetLang}` : `/${targetLang}${stripped}`;

const tooltipText = lang === "en" ? "Cambiar a Español" : "Switch to English";
---

<div class="relative group">
    <a
        href={toggleUrl}
        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-mono border border-[var(--line)] text-[var(--fg-dim)] hover:border-[var(--green)] hover:text-[var(--green)] transition-colors"
        aria-label={tooltipText}
    >
        <span class={lang === 'en' ? 'text-[var(--green)]' : 'text-[var(--fg-muted)]'}>en</span>
        <span class="text-[var(--line-bright)]">/</span>
        <span class={lang === 'es' ? 'text-[var(--green)]' : 'text-[var(--fg-muted)]'}>es</span>
    </a>

    <div class="absolute top-full mt-2 right-0 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
        <div class="bg-[var(--bg-elev)] text-[var(--fg-dim)] border border-[var(--line)] px-2.5 py-1 text-[11px] whitespace-nowrap font-mono">
            // {tooltipText}
        </div>
    </div>
</div>
