---
import { Image } from "astro:assets";

interface Item {
    slug: string;
    title: string;
    description: string;
    tech: string[];
    image: any;
    demoUrl?: string;
    githubUrl?: string;
    type: string;
}

interface Props {
    items: Item[];
    lang: "en" | "es";
}

const { items, lang } = Astro.props;
const projectsBase = lang === "es" ? "/es/projects" : "/projects";

const typeLabels: Record<string, { es: string; en: string }> = {
    producto: { es: "Producto", en: "Product" },
    product: { es: "Producto", en: "Product" },
    caso: { es: "Caso de Uso", en: "Use Case" },
    case: { es: "Caso de Uso", en: "Use Case" },
};

const normalizedType = (t: string) => (t === "producto" || t === "product" ? "product" : "case");

// Build the unique list of tech tags from all items for the filter UI
const allTechs = Array.from(
    new Set(items.flatMap((p) => p.tech || []))
).sort();

const labels = lang === "es"
    ? {
          filterAll: "todos",
          filterProducts: "productos",
          filterCases: "casos",
          filterByTech: "filtrar por tech",
          empty: "// no hay proyectos con ese filtro",
          viewCase: "ver caso",
          openDemo: "./abrir-demo",
          count: "proyectos",
      }
    : {
          filterAll: "all",
          filterProducts: "products",
          filterCases: "use cases",
          filterByTech: "filter by tech",
          empty: "// no projects match that filter",
          viewCase: "view case",
          openDemo: "./open-demo",
          count: "projects",
      };
---

<div data-projects-grid>
    <!-- Filter bar -->
    <div class="border border-[var(--line)] mb-6">
        <div class="flex flex-wrap items-center gap-2 px-4 py-3 border-b border-[var(--line)] text-xs font-mono">
            <span class="text-[var(--fg-muted)] mr-2">// type:</span>
            <button type="button" data-pg-type="all" data-active="true" class="pg-chip">{labels.filterAll}</button>
            <button type="button" data-pg-type="product" class="pg-chip">{labels.filterProducts}</button>
            <button type="button" data-pg-type="case" class="pg-chip">{labels.filterCases}</button>
            <span class="ml-auto text-[var(--fg-muted)]">
                <span data-pg-count>{items.length}</span> {labels.count}
            </span>
        </div>
        <div class="flex flex-wrap items-center gap-2 px-4 py-3 text-xs font-mono">
            <span class="text-[var(--fg-muted)] mr-2">// tech:</span>
            <button type="button" data-pg-tech="all" data-active="true" class="pg-chip">{labels.filterAll}</button>
            {allTechs.map((tech) => (
                <button type="button" data-pg-tech={tech} class="pg-chip">{tech}</button>
            ))}
        </div>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0 border border-[var(--line)] -mt-px" data-pg-track>
        {items.map((p, index) => (
            <article
                data-pg-card
                data-pg-card-type={normalizedType(p.type)}
                data-pg-card-tech={(p.tech || []).join("|")}
                class={`panel-accent group border-0 ${index % 3 !== 0 ? 'md:border-l' : ''} ${index % 2 !== 0 ? 'border-l md:border-l-0' : ''} ${index % 3 === 2 ? 'lg:border-l' : ''} ${index > 0 ? 'border-t' : ''} border-[var(--line)]`}
            >
                <a href={`${projectsBase}/${p.slug}`} class="block aspect-[16/9] overflow-hidden border-b border-[var(--line)] relative bg-[var(--bg-elev)]">
                    <Image
                        src={p.image}
                        alt={p.title}
                        class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500 grayscale group-hover:grayscale-0"
                        loading="lazy"
                        width={600}
                        height={340}
                        format="webp"
                    />
                    <div class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-2 py-1 text-[10px] uppercase tracking-wider bg-black/80 backdrop-blur border border-[var(--line-bright)] text-[var(--green)]">
                        <span class="w-1 h-1 rounded-full bg-[var(--green)]"></span>
                        {typeLabels[p.type]?.[lang] || p.type}
                    </div>
                </a>
                <div class="p-5 md:p-6 space-y-3">
                    <a href={`${projectsBase}/${p.slug}`} class="flex items-baseline gap-3 hover:no-underline">
                        <span class="text-xs text-[var(--fg-muted)] font-mono shrink-0">{String(index + 1).padStart(2, '0')}/</span>
                        <h3 class="text-base font-semibold text-[var(--fg)] group-hover:text-[var(--green)] transition-colors leading-tight">{p.title}</h3>
                    </a>
                    <p class="text-[13px] text-[var(--fg-dim)] leading-relaxed line-clamp-3">{p.description}</p>
                    <div class="flex flex-wrap gap-1.5 pt-2">
                        {(p.tech || []).slice(0, 4).map((tech) => (
                            <span class="badge-mono">{tech}</span>
                        ))}
                        {(p.tech || []).length > 4 && (
                            <span class="badge-mono">+{p.tech.length - 4}</span>
                        )}
                    </div>
                    <div class="flex items-center gap-4 pt-3 text-xs">
                        <a href={`${projectsBase}/${p.slug}`} class="inline-flex items-center gap-1.5 text-[var(--fg-dim)] hover:text-[var(--green)] transition-colors">
                            <span class="text-[var(--green)]">▸</span>
                            <span>{labels.viewCase}</span>
                            <span class="transition-transform group-hover:translate-x-0.5">→</span>
                        </a>
                        {p.demoUrl && (
                            <a href={p.demoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[var(--green)] hover:text-[var(--green-bright)] transition-colors ml-auto">
                                <span>{labels.openDemo}</span>
                                <span>↗</span>
                            </a>
                        )}
                    </div>
                </div>
            </article>
        ))}
    </div>

    <div data-pg-empty class="hidden border border-[var(--line)] -mt-px p-10 text-center text-sm text-[var(--fg-muted)] font-mono">
        {labels.empty}
    </div>
</div>

<style>
    .pg-chip {
        padding: 3px 9px;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 11px;
        color: var(--fg-muted);
        background: transparent;
        border: 1px solid var(--line-bright);
        cursor: pointer;
        transition: all 120ms;
    }
    .pg-chip:hover { color: var(--green); border-color: var(--green); }
    .pg-chip[data-active="true"] {
        background: rgba(74, 222, 128, 0.08);
        color: var(--green);
        border-color: var(--green);
    }
    [data-pg-card][hidden] { display: none; }
</style>

<script>
    document.querySelectorAll<HTMLElement>("[data-projects-grid]").forEach((root) => {
        const cards = root.querySelectorAll<HTMLElement>("[data-pg-card]");
        const typeBtns = root.querySelectorAll<HTMLButtonElement>("[data-pg-type]");
        const techBtns = root.querySelectorAll<HTMLButtonElement>("[data-pg-tech]");
        const counter = root.querySelector<HTMLElement>("[data-pg-count]");
        const empty = root.querySelector<HTMLElement>("[data-pg-empty]");

        let activeType = "all";
        let activeTech = "all";

        function apply() {
            let visible = 0;
            cards.forEach((card) => {
                const type = card.getAttribute("data-pg-card-type") || "";
                const techs = (card.getAttribute("data-pg-card-tech") || "").split("|");
                const typeOk = activeType === "all" || type === activeType;
                const techOk = activeTech === "all" || techs.includes(activeTech);
                const show = typeOk && techOk;
                if (show) {
                    card.removeAttribute("hidden");
                    visible++;
                } else {
                    card.setAttribute("hidden", "");
                }
            });
            if (counter) counter.textContent = String(visible);
            if (empty) empty.classList.toggle("hidden", visible !== 0);
        }

        typeBtns.forEach((b) =>
            b.addEventListener("click", () => {
                activeType = b.getAttribute("data-pg-type") || "all";
                typeBtns.forEach((x) => x.setAttribute("data-active", String(x === b)));
                apply();
            })
        );
        techBtns.forEach((b) =>
            b.addEventListener("click", () => {
                activeTech = b.getAttribute("data-pg-tech") || "all";
                techBtns.forEach((x) => x.setAttribute("data-active", String(x === b)));
                apply();
            })
        );
    });
</script>
