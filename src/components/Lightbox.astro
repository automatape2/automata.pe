---
// Lightbox — fullscreen image overlay with prev/next/Esc.
// Any element with [data-lightbox-trigger] inside the page becomes clickable;
// the closest [data-lightbox-group] determines the slideshow scope.
// Triggers contribute their `data-lightbox-src` (full-res) and optional
// `data-lightbox-caption`. If no src is given, the inner <img> src is used.
---

<div id="lightbox" class="lb-overlay" data-open="false" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image viewer">
    <div class="lb-bar">
        <span class="lb-counter">
            <span data-lb-current>1</span>
            <span class="lb-sep">/</span>
            <span data-lb-total>1</span>
        </span>
        <span class="lb-caption" data-lb-caption></span>
        <button type="button" data-lb-close class="lb-btn" aria-label="Close (Esc)">[ esc ]</button>
    </div>
    <button type="button" data-lb-prev class="lb-nav lb-nav-prev" aria-label="Previous image">◂</button>
    <img data-lb-image class="lb-image" alt="" />
    <button type="button" data-lb-next class="lb-nav lb-nav-next" aria-label="Next image">▸</button>
</div>

<style is:global>
    .lb-overlay {
        position: fixed;
        inset: 0;
        z-index: 250;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(6px);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 56px 48px;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
    }
    .lb-overlay[data-open="true"] { display: flex; }

    .lb-bar {
        position: absolute;
        top: 14px;
        left: 14px;
        right: 14px;
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 11px;
        color: var(--fg-muted);
    }
    .lb-counter [data-lb-current] { color: var(--green); }
    .lb-sep { margin: 0 4px; color: var(--line-bright); }
    .lb-caption { flex: 1; color: var(--fg-dim); }
    .lb-btn {
        background: transparent;
        border: 1px solid var(--line-bright);
        color: var(--fg-dim);
        padding: 2px 8px;
        font: inherit;
        font-size: 11px;
        cursor: pointer;
    }
    .lb-btn:hover { color: var(--green); border-color: var(--green); }

    .lb-image {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border: 1px solid var(--line);
    }
    .lb-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 44px;
        height: 44px;
        background: rgba(0, 0, 0, 0.6);
        border: 1px solid var(--line-bright);
        color: var(--fg-dim);
        font-size: 18px;
        cursor: pointer;
        transition: all 120ms;
    }
    .lb-nav:hover { color: var(--green); border-color: var(--green); }
    .lb-nav-prev { left: 14px; }
    .lb-nav-next { right: 14px; }
    .lb-nav:disabled { opacity: 0.3; cursor: not-allowed; }
</style>

<script>
    type LbTrigger = { src: string; caption: string; el: HTMLElement };

    const overlay = document.getElementById("lightbox");
    if (overlay) {
        const img = overlay.querySelector<HTMLImageElement>("[data-lb-image]")!;
        const current = overlay.querySelector<HTMLElement>("[data-lb-current]")!;
        const total = overlay.querySelector<HTMLElement>("[data-lb-total]")!;
        const captionEl = overlay.querySelector<HTMLElement>("[data-lb-caption]")!;
        const prevBtn = overlay.querySelector<HTMLButtonElement>("[data-lb-prev]")!;
        const nextBtn = overlay.querySelector<HTMLButtonElement>("[data-lb-next]")!;
        const closeBtn = overlay.querySelector<HTMLButtonElement>("[data-lb-close]")!;

        let group: LbTrigger[] = [];
        let index = 0;

        function collectGroup(el: HTMLElement): LbTrigger[] {
            const scope = el.closest<HTMLElement>("[data-lightbox-group]") ?? document;
            return [...scope.querySelectorAll<HTMLElement>("[data-lightbox-trigger]")].map((t) => {
                const src =
                    t.getAttribute("data-lightbox-src") ||
                    t.querySelector("img")?.getAttribute("src") ||
                    "";
                const caption =
                    t.getAttribute("data-lightbox-caption") ||
                    t.querySelector("img")?.getAttribute("alt") ||
                    "";
                return { src, caption, el: t };
            });
        }

        function render() {
            const item = group[index];
            if (!item) return;
            img.src = item.src;
            img.alt = item.caption;
            captionEl.textContent = item.caption;
            current.textContent = String(index + 1);
            total.textContent = String(group.length);
            prevBtn.disabled = index === 0;
            nextBtn.disabled = index === group.length - 1;
        }

        function open(triggerEl: HTMLElement) {
            group = collectGroup(triggerEl);
            index = group.findIndex((g) => g.el === triggerEl);
            if (index < 0) index = 0;
            render();
            overlay.setAttribute("data-open", "true");
            overlay.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
        }
        function close() {
            overlay.setAttribute("data-open", "false");
            overlay.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
        }
        function move(delta: number) {
            index = Math.max(0, Math.min(group.length - 1, index + delta));
            render();
        }

        document.addEventListener("click", (e) => {
            const trigger = (e.target as HTMLElement)?.closest<HTMLElement>("[data-lightbox-trigger]");
            if (trigger) {
                e.preventDefault();
                open(trigger);
            }
        });
        prevBtn.addEventListener("click", () => move(-1));
        nextBtn.addEventListener("click", () => move(1));
        closeBtn.addEventListener("click", close);
        overlay.addEventListener("click", (e) => {
            // click on the dark backdrop (not on inner elements) closes
            if (e.target === overlay) close();
        });
        document.addEventListener("keydown", (e) => {
            if (overlay.getAttribute("data-open") !== "true") return;
            if (e.key === "Escape") { e.preventDefault(); close(); }
            else if (e.key === "ArrowLeft") { e.preventDefault(); move(-1); }
            else if (e.key === "ArrowRight") { e.preventDefault(); move(1); }
        });
    }
</script>
