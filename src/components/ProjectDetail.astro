---
import { Image } from "astro:assets";
import { codeToHtml } from "shiki";
import MermaidViewer from "./MermaidViewer.astro";
import MasterDetail from "./MasterDetail.astro";
import Carousel from "./Carousel.astro";
import TableOfContents from "./TableOfContents.astro";
import type { Project } from "../types/project";

interface Props {
    project: Project;
    lang: "en" | "es";
    prev?: Project | null;
    next?: Project | null;
    related?: Project[];
}

const { project, lang, prev, next, related = [] } = Astro.props;

// Custom Shiki theme matching the terminal palette (green keywords, amber strings, cyan types)
const automataShikiTheme: any = {
    name: "automata",
    type: "dark",
    colors: {
        "editor.background": "#000000",
        "editor.foreground": "#E5E7EB",
    },
    tokenColors: [
        { scope: ["comment", "punctuation.definition.comment"], settings: { foreground: "#6B7280", fontStyle: "italic" } },
        { scope: ["keyword", "storage", "storage.type", "storage.modifier"], settings: { foreground: "#4ADE80" } },
        { scope: ["keyword.control"], settings: { foreground: "#4ADE80" } },
        { scope: ["string", "string.quoted", "string.template"], settings: { foreground: "#FBBF24" } },
        { scope: ["constant.numeric", "constant.language"], settings: { foreground: "#67E8F9" } },
        { scope: ["entity.name.function", "support.function", "meta.function-call.generic"], settings: { foreground: "#67E8F9" } },
        { scope: ["variable", "variable.other"], settings: { foreground: "#E5E7EB" } },
        { scope: ["entity.name.type", "support.type", "support.class", "entity.name.class"], settings: { foreground: "#06B6D4" } },
        { scope: ["punctuation", "meta.brace"], settings: { foreground: "#9CA3AF" } },
        { scope: ["variable.parameter"], settings: { foreground: "#E5E7EB" } },
        { scope: ["meta.template.expression"], settings: { foreground: "#FBBF24" } },
        { scope: ["keyword.operator"], settings: { foreground: "#9CA3AF" } },
        { scope: ["entity.name.tag"], settings: { foreground: "#4ADE80" } },
        { scope: ["entity.other.attribute-name"], settings: { foreground: "#FBBF24" } },
    ],
};

// Word count + reading time across all human-readable project text (code excluded).
function collectWords(value: any, out: string[]): void {
    if (value == null) return;
    if (typeof value === "string") out.push(value);
    else if (Array.isArray(value)) value.forEach((v) => collectWords(v, out));
    else if (typeof value === "object") {
        for (const [k, v] of Object.entries(value)) {
            // skip raw code, mermaid sources and ascii art — they aren't "reading" text
            if (["code", "mermaid", "ascii", "image", "screenshots"].includes(k)) continue;
            collectWords(v, out);
        }
    }
}
const _wordBuf: string[] = [];
collectWords(project, _wordBuf);
const wordCount = _wordBuf.join(" ").trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 220));

// Pre-highlight all code snippets in techChallenges (server-side, zero client cost)
const challenges = await Promise.all(
    ((project.techChallenges || []) as any[]).map(async (ch) => ({
        ...ch,
        codeHtml: ch.code
            ? await codeToHtml(ch.code, {
                  lang: (ch.codeLang || "typescript") as any,
                  theme: automataShikiTheme,
              })
            : null,
    }))
);

// Pre-highlight implementation code highlights too
const codeHighlights = await Promise.all(
    ((project.codeHighlights || []) as any[]).map(async (ch) => ({
        ...ch,
        codeHtml: ch.code
            ? await codeToHtml(ch.code, {
                  lang: (ch.lang || "typescript") as any,
                  theme: automataShikiTheme,
              })
            : null,
    }))
);
const projectsBase = lang === "es" ? "/es/projects" : "/projects";

// Normalize a diagram entry into { mermaid?, ascii? }
const normalizeDiagram = (v: any): { mermaid?: string; ascii?: string } | null => {
    if (!v) return null;
    if (typeof v === "string") return { ascii: v };
    if (typeof v === "object") return { mermaid: v.mermaid, ascii: v.ascii };
    return null;
};

const L = {
    en: {
        back: "cd ..  // back to projects",
        sections: {
            spec: "// spec", status: "// status",
            discovery: "discovery", design: "design",
            architecture: "architecture", infra: "infrastructure",
            implementation: "implementation",
            techChallenges: "technical challenges",
            testing: "testing & ci",
            screenshots: "screenshots", results: "results",
            lessons: "lessons learned",
            quickFacts: "quick facts", nextStep: "next step",
            overview: "overview", problem: "problem",
            audience: "audience", role: "role", timeline: "timeline",
            team: "team", responsibilities: "responsibilities",
            tools: "tools", system: "design system",
            artifacts: "artifacts", figmaLink: "figma file",
            c4Context: "c4 / context", c4Container: "c4 / container",
            c4Component: "c4 / component",
            services: "services", flow: "data flow",
            frontend: "frontend", backend: "backend", data: "data",
            ai: "ai", devops: "devops",
            strategy: "strategy", coverage: "coverage", tests: "tests",
            metrics: "metrics", outcomes: "outcomes",
            tcProblem: "problem", tcConstraint: "constraint",
            tcApproach: "approach", tcAlgorithm: "algorithm / technique",
            tcOutcome: "outcome", tcChallenge: "challenge",
            openDemo: "./open-demo --live",
            viewFigma: "./open-figma",
            viewRepo: "git clone",
            navPrev: "prev",
            navNext: "next",
            navMore: "more case studies",
            letsTalk: "./let-s-talk.sh",
            ctaTitle: "automata deploy --your-operation",
            ctaSub: "Let's talk about adapting this to your case.",
            todo: "TODO",
        },
    },
    es: {
        back: "cd ..  // volver a proyectos",
        sections: {
            spec: "// spec", status: "// estado",
            discovery: "descubrimiento", design: "diseño",
            architecture: "arquitectura", infra: "infraestructura",
            implementation: "implementacion",
            techChallenges: "desafios tecnicos",
            testing: "testing & ci",
            screenshots: "capturas", results: "resultados",
            lessons: "lecciones",
            quickFacts: "quick facts", nextStep: "siguiente paso",
            overview: "descripcion", problem: "problema",
            audience: "audiencia", role: "rol", timeline: "tiempo",
            team: "equipo", responsibilities: "responsabilidades",
            tools: "herramientas", system: "sistema de diseño",
            artifacts: "artefactos", figmaLink: "archivo de figma",
            c4Context: "c4 / contexto", c4Container: "c4 / contenedor",
            c4Component: "c4 / componente",
            services: "servicios", flow: "flujo de datos",
            frontend: "frontend", backend: "backend", data: "datos",
            ai: "ia", devops: "devops",
            strategy: "estrategia", coverage: "cobertura", tests: "tests",
            metrics: "metricas", outcomes: "outcomes",
            tcProblem: "problema", tcConstraint: "restriccion",
            tcApproach: "enfoque", tcAlgorithm: "algoritmo / tecnica",
            tcOutcome: "outcome", tcChallenge: "desafio",
            openDemo: "./abrir-demo --live",
            viewFigma: "./abrir-figma",
            viewRepo: "git clone",
            navPrev: "anterior",
            navNext: "siguiente",
            navMore: "mas proyectos",
            letsTalk: "./contactar.sh",
            ctaTitle: "automata deploy --tu-operacion",
            ctaSub: "Conversemos sobre como adaptamos esto a tu caso.",
            todo: "TODO",
        },
    },
}[lang];

const typeLabel: Record<string, string> = {
    producto: lang === "es" ? "PRODUCTO" : "PRODUCT",
    product: lang === "es" ? "PRODUCTO" : "PRODUCT",
    caso: lang === "es" ? "CASO DE USO" : "USE CASE",
    case: lang === "es" ? "CASO DE USO" : "USE CASE",
};

const backHref = lang === "es" ? "/es#solutions" : "/#solutions";
const contactHref = lang === "es" ? "/es#contact" : "/#contact";

const has = (v: any) => Array.isArray(v) ? v.length > 0 : (v !== undefined && v !== null && v !== "");
const hasObj = (o: any) => o && Object.values(o).some((v: any) => has(v));

const stackGroups = project.stack
    ? [
        { key: "frontend", items: project.stack.frontend },
        { key: "backend",  items: project.stack.backend  },
        { key: "data",     items: project.stack.data     },
        { key: "ai",       items: project.stack.ai       },
        { key: "devops",   items: project.stack.devops   },
      ].filter(g => has(g.items))
    : [];

// Static class lookup so Tailwind scanner picks up each utility
const lgCols = (n: number) => (
    n <= 1 ? "lg:grid-cols-1" :
    n === 2 ? "lg:grid-cols-2" :
    n === 3 ? "lg:grid-cols-3" :
    n === 4 ? "lg:grid-cols-4" :
    "lg:grid-cols-5"
);
const stackColsClass = lgCols(stackGroups.length || 1);
const metricsColsClass = project.metrics ? lgCols(Math.min(project.metrics.length, 4)) : "";

// Build TOC items from what the project actually has
const tocItems: { id: string; label: string; sublabel?: string }[] = [];
tocItems.push({ id: "overview", label: lang === "es" ? "overview" : "overview" });
if (project.fullDescription || project.problem || project.audience) {
    tocItems.push({ id: "sec-discovery", label: L.sections.discovery, sublabel: "section 01" });
}
if (project.designTools || project.designSystem || project.figmaUrl) {
    tocItems.push({ id: "sec-design", label: L.sections.design, sublabel: "section 02" });
}
if (project.architecture) {
    tocItems.push({ id: "sec-architecture", label: L.sections.architecture, sublabel: "section 03" });
}
if (project.infrastructure) {
    tocItems.push({ id: "sec-infrastructure", label: L.sections.infra, sublabel: "section 04" });
}
if (stackGroups.length > 0 || project.codeHighlights) {
    tocItems.push({ id: "sec-implementation", label: L.sections.implementation, sublabel: "section 05" });
}
if (project.techChallenges && project.techChallenges.length > 0) {
    tocItems.push({ id: "sec-challenges", label: L.sections.techChallenges, sublabel: "section 06" });
}
if (project.testing) {
    tocItems.push({ id: "sec-testing", label: L.sections.testing, sublabel: "section 07" });
}
if (project.screenshots && project.screenshots.length > 0) {
    tocItems.push({ id: "sec-screenshots", label: L.sections.screenshots, sublabel: "section 08" });
}
if (project.metrics || project.results || project.challenges) {
    tocItems.push({ id: "sec-results", label: L.sections.results, sublabel: "section 09" });
}
if (project.lessons && project.lessons.length > 0) {
    tocItems.push({ id: "sec-lessons", label: L.sections.lessons, sublabel: "section 10" });
}
---

<div class="max-w-7xl mx-auto px-6 lg:px-12 py-12 lg:grid lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-10">

    <div class="lg:order-1">
        <TableOfContents items={tocItems} title={lang === "es" ? "// secciones" : "// sections"} />
    </div>

    <div class="lg:order-2 min-w-0">

    <!-- Back link -->
    <a href={backHref} class="inline-flex items-center gap-2 text-sm text-[var(--fg-muted)] hover:text-[var(--green)] transition-colors mb-8 group">
        <span class="text-[var(--green)]">$</span>
        <span>{L.back}</span>
        <span class="text-[var(--green)] opacity-0 group-hover:opacity-100 transition-opacity">←</span>
    </a>

    <!-- Header panel -->
    <div id="overview" class="panel mb-8 scroll-mt-20">
        <div class="window-chrome">
            <div class="window-chrome-title">automata@latam: ~/{lang === "es" ? "proyectos" : "projects"}/{project.slug}</div>
        </div>
        <div class="p-5 md:p-7 grid lg:grid-cols-[1.3fr_1fr] gap-6 lg:gap-10 items-start">
            <div class="space-y-5">
                <div class="flex items-center gap-3 text-xs text-[var(--fg-muted)] flex-wrap">
                    <span class="inline-flex items-center gap-1.5 px-2 py-1 border border-[var(--line-bright)] text-[var(--green)]">
                        <span class="w-1 h-1 rounded-full bg-[var(--green)]"></span>
                        {typeLabel[project.type] || project.type}
                    </span>
                    <span class="text-[var(--line-bright)]">·</span>
                    <span class="font-mono">slug: {project.slug}</span>
                    {project.year && (<><span class="text-[var(--line-bright)]">·</span><span class="font-mono">{project.year}</span></>)}
                    <span class="text-[var(--line-bright)]">·</span>
                    <span class="font-mono">{readingMinutes} min read</span>
                    <span class="text-[var(--line-bright)]">·</span>
                    <span class="font-mono">{wordCount.toLocaleString()} words</span>
                </div>

                <h1 class="heading-mono text-[clamp(2rem,5vw,3.5rem)] text-[var(--fg)]">
                    <span class="text-[var(--green)]">{'>'}</span> {project.title}
                </h1>

                <p class="text-[var(--fg-dim)] text-base leading-relaxed max-w-xl">
                    <span class="text-[var(--fg-muted)]">// </span>{project.description}
                </p>

                <div class="flex flex-wrap gap-2 pt-2">
                    {project.tech.map((tech: string) => (<span class="badge-mono">{tech}</span>))}
                </div>

                {project.githubUrl && (
                    <div
                        class="flex items-center gap-4 pt-1 text-xs font-mono text-[var(--fg-muted)]"
                        data-gh-stats
                        data-gh-url={project.githubUrl}
                        aria-live="polite"
                    >
                        <span class="gh-stat opacity-50">★ <span data-gh-stars>—</span></span>
                        <span class="gh-stat opacity-50"><span data-gh-forks>—</span> forks</span>
                        <span class="gh-stat opacity-50">last commit <span data-gh-pushed>—</span></span>
                    </div>
                )}

                <div class="flex flex-wrap gap-3 pt-2">
                    {project.demoUrl && (
                        <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn-cli btn-cli--primary">
                            <span>{L.sections.openDemo}</span>
                        </a>
                    )}
                    {project.githubUrl && (
                        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-cli inline-flex items-center gap-2" aria-label="GitHub repository">
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                            </svg>
                            <span>{L.sections.viewRepo}</span>
                        </a>
                    )}
                    {project.figmaUrl && (
                        <a href={project.figmaUrl} target="_blank" rel="noopener noreferrer" class="btn-cli">
                            <span>{L.sections.viewFigma}</span>
                        </a>
                    )}
                </div>
            </div>

            <div class="border border-[var(--line)] bg-black overflow-hidden">
                <Image
                    src={project.image}
                    alt={project.title}
                    class="w-full h-auto object-cover"
                    loading="eager"
                    width={720}
                    height={480}
                    widths={[360, 540, 720]}
                    sizes="(max-width: 1024px) 100vw, 480px"
                    formats={["avif", "webp"]}
                />
            </div>
        </div>
    </div>

    <!-- Quick facts grid -->
    {(project.role || project.timeline || project.team || project.demoUrl) && (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-0 border border-[var(--line)] mb-8">
            {project.role && (
                <div class="p-5 border-r border-[var(--line)]">
                    <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--fg-muted)] mb-2">▸ {L.sections.role}</div>
                    <div class="text-sm text-[var(--fg)]">{project.role}</div>
                </div>
            )}
            {project.timeline && (
                <div class="p-5 border-r border-[var(--line)]">
                    <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--fg-muted)] mb-2">▸ {L.sections.timeline}</div>
                    <div class="text-sm text-[var(--fg)]">{project.timeline}</div>
                </div>
            )}
            {project.team && (
                <div class="p-5 border-r border-[var(--line)]">
                    <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--fg-muted)] mb-2">▸ {L.sections.team}</div>
                    <div class="text-sm text-[var(--fg)]">{project.team}</div>
                </div>
            )}
            <div class="p-5">
                <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--fg-muted)] mb-2">▸ status</div>
                <div class="text-sm text-[var(--green)]">{project.demoUrl ? "online" : "ready"}</div>
            </div>
        </div>
    )}

    <!-- 01 · Discovery -->
    {(project.fullDescription || project.problem || project.audience) && (
        <section id="sec-discovery" class="mb-10 scroll-mt-20">
            <div class="border-b border-[var(--line)] pb-3 mb-5">
                <div class="text-xs text-[var(--fg-muted)] mb-1">// section 01 · {L.sections.discovery}</div>
                <h2 class="heading-mono text-2xl">
                    <span class="text-[var(--green)]">$</span> cat ./{L.sections.discovery}.md
                </h2>
            </div>
            <div class="grid md:grid-cols-3 gap-0 border border-[var(--line)]">
                {project.fullDescription && (
                    <div class="panel border-0 p-6 md:col-span-3">
                        <div class="text-xs text-[var(--fg-muted)] mb-3">▸ {L.sections.overview}</div>
                        <p class="text-[var(--fg-dim)] leading-relaxed">{project.fullDescription}</p>
                    </div>
                )}
                {project.problem && (
                    <div class={`panel border-0 p-6 ${project.fullDescription ? 'border-t' : ''} ${project.audience ? 'md:col-span-2 md:border-r' : 'md:col-span-3'} border-[var(--line)]`}>
                        <div class="text-xs text-[var(--amber)] mb-3">▸ {L.sections.problem}</div>
                        <p class="text-[var(--fg-dim)] text-sm leading-relaxed">{project.problem}</p>
                    </div>
                )}
                {project.audience && (
                    <div class={`panel border-0 p-6 border-t md:border-t-0 border-[var(--line)] ${project.problem ? '' : 'md:col-span-3'}`}>
                        <div class="text-xs text-[var(--cyan)] mb-3">▸ {L.sections.audience}</div>
                        <p class="text-[var(--fg-dim)] text-sm leading-relaxed">{project.audience}</p>
                    </div>
                )}
            </div>
        </section>
    )}

    <!-- 02 · Design -->
    {(project.designTools || project.designSystem || project.figmaUrl) && (
        <section id="sec-design" class="mb-10 scroll-mt-20">
            <div class="border-b border-[var(--line)] pb-3 mb-5">
                <div class="text-xs text-[var(--fg-muted)] mb-1">// section 02 · {L.sections.design}</div>
                <h2 class="heading-mono text-2xl">
                    <span class="text-[var(--green)]">$</span> cat ./{L.sections.design}.md
                </h2>
            </div>
            <div class="grid md:grid-cols-2 gap-0 border border-[var(--line)]">
                {project.designTools && (
                    <div class="panel border-0 p-6">
                        <div class="text-xs text-[var(--fg-muted)] mb-3">▸ {L.sections.tools}</div>
                        <div class="flex flex-wrap gap-2">
                            {project.designTools.map((t: string) => (<span class="badge-mono">{t}</span>))}
                        </div>
                        {project.figmaUrl && (
                            <a href={project.figmaUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-4 text-xs text-[var(--green)] link-mono">
                                <span>▸ {L.sections.figmaLink}</span>
                                <span>↗</span>
                            </a>
                        )}
                    </div>
                )}
                {project.designSystem && (
                    <div class={`panel border-0 p-6 ${project.designTools ? 'border-t md:border-t-0 md:border-l' : ''} border-[var(--line)]`}>
                        <div class="text-xs text-[var(--fg-muted)] mb-3">▸ {L.sections.system}</div>
                        <ul class="text-sm space-y-1.5">
                            {project.designSystem.map((d: string) => (
                                <li class="flex items-start gap-2 text-[var(--fg-dim)]">
                                    <span class="text-[var(--green)] shrink-0">·</span>
                                    <span>{d}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
            </div>
        </section>
    )}

    <!-- 03 · Architecture (master-detail: sidebar picker + active diagram) -->
    {project.architecture && (() => {
        const ctx = normalizeDiagram(project.architecture.context);
        const ctn = normalizeDiagram(project.architecture.container);
        const cmp = normalizeDiagram(project.architecture.component);
        const items = [];
        if (ctx) items.push({ key: "context",   label: L.sections.c4Context,   sublabel: "c4-level-1" });
        if (ctn) items.push({ key: "container", label: L.sections.c4Container, sublabel: "c4-level-2" });
        if (cmp) items.push({ key: "component", label: L.sections.c4Component, sublabel: "c4-level-3" });
        if (items.length === 0) return null;
        return (
            <section id="sec-architecture" class="mb-10 scroll-mt-20">
                <div class="border-b border-[var(--line)] pb-3 mb-5">
                    <div class="text-xs text-[var(--fg-muted)] mb-1">// section 03 · {L.sections.architecture}</div>
                    <h2 class="heading-mono text-2xl">
                        <span class="text-[var(--green)]">$</span> cat ./{L.sections.architecture}.md
                    </h2>
                </div>

                <MasterDetail items={items} title="// levels">
                    {ctx && (
                        <div data-md-key="context">
                            {ctx.mermaid ? (
                                <MermaidViewer source={ctx.mermaid} label={`${L.sections.c4Context} · c4-level-1`} fallback={ctx.ascii} />
                            ) : (
                                <div class="panel border-0">
                                    <div class="window-chrome"><div class="window-chrome-title">{L.sections.c4Context} · c4-level-1</div></div>
                                    <pre class="p-6 overflow-x-auto text-[12px] leading-[1.5] text-[var(--fg)] font-mono">{ctx.ascii}</pre>
                                </div>
                            )}
                        </div>
                    )}
                    {ctn && (
                        <div data-md-key="container" class="hidden">
                            {ctn.mermaid ? (
                                <MermaidViewer source={ctn.mermaid} label={`${L.sections.c4Container} · c4-level-2`} fallback={ctn.ascii} />
                            ) : (
                                <div class="panel border-0">
                                    <div class="window-chrome"><div class="window-chrome-title">{L.sections.c4Container} · c4-level-2</div></div>
                                    <pre class="p-6 overflow-x-auto text-[12px] leading-[1.5] text-[var(--fg)] font-mono">{ctn.ascii}</pre>
                                </div>
                            )}
                        </div>
                    )}
                    {cmp && (
                        <div data-md-key="component" class="hidden">
                            {cmp.mermaid ? (
                                <MermaidViewer source={cmp.mermaid} label={`${L.sections.c4Component} · c4-level-3`} fallback={cmp.ascii} />
                            ) : (
                                <div class="panel border-0">
                                    <div class="window-chrome"><div class="window-chrome-title">{L.sections.c4Component} · c4-level-3</div></div>
                                    <pre class="p-6 overflow-x-auto text-[12px] leading-[1.5] text-[var(--fg)] font-mono">{cmp.ascii}</pre>
                                </div>
                            )}
                        </div>
                    )}
                </MasterDetail>
            </section>
        );
    })()}

    <!-- 04 · Infrastructure -->
    {project.infrastructure && (
        <section id="sec-infrastructure" class="mb-10 scroll-mt-20">
            <div class="border-b border-[var(--line)] pb-3 mb-5">
                <div class="text-xs text-[var(--fg-muted)] mb-1">// section 04 · {L.sections.infra}</div>
                <h2 class="heading-mono text-2xl">
                    <span class="text-[var(--green)]">$</span> cat ./{L.sections.infra}.md
                </h2>
            </div>
            <div class="grid lg:grid-cols-[1fr_1.4fr] gap-0 border border-[var(--line)]">
                <div class="panel border-0 p-6">
                    <div class="text-xs text-[var(--fg-muted)] mb-3">▸ {L.sections.services}</div>
                    {project.infrastructure.provider && (
                        <div class="mb-3 text-sm">
                            <span class="text-[var(--fg-muted)]">provider: </span>
                            <span class="text-[var(--cyan)]">{project.infrastructure.provider}</span>
                        </div>
                    )}
                    {project.infrastructure.services && (
                        <ul class="text-sm space-y-1.5">
                            {project.infrastructure.services.map((s: string) => (
                                <li class="flex items-start gap-2 text-[var(--fg-dim)]">
                                    <span class="text-[var(--green)] shrink-0">▸</span>
                                    <span>{s}</span>
                                </li>
                            ))}
                        </ul>
                    )}
                </div>
                {project.infrastructure.diagram && (() => {
                    const d = normalizeDiagram(project.infrastructure.diagram);
                    return d && (d.mermaid ? (
                        <div class="border-t lg:border-t-0 lg:border-l border-[var(--line)]">
                            <MermaidViewer source={d.mermaid} label={L.sections.flow} fallback={d.ascii} />
                        </div>
                    ) : (
                        <div class="panel border-0 border-t lg:border-t-0 lg:border-l border-[var(--line)]">
                            <div class="window-chrome"><div class="window-chrome-title">{L.sections.flow}</div></div>
                            <pre class="p-6 overflow-x-auto text-[12px] leading-[1.5] text-[var(--fg)] font-mono">{d.ascii}</pre>
                        </div>
                    ));
                })()}
            </div>
        </section>
    )}

    <!-- 05 · Implementation -->
    {(stackGroups.length > 0 || project.codeHighlights) && (
        <section id="sec-implementation" class="mb-10 scroll-mt-20">
            <div class="border-b border-[var(--line)] pb-3 mb-5">
                <div class="text-xs text-[var(--fg-muted)] mb-1">// section 05 · {L.sections.implementation}</div>
                <h2 class="heading-mono text-2xl">
                    <span class="text-[var(--green)]">$</span> cat ./{L.sections.implementation}.md
                </h2>
            </div>

            {stackGroups.length > 0 && (
                <div class={`grid grid-cols-1 md:grid-cols-2 ${stackColsClass} gap-0 border border-[var(--line)] mb-6`}>
                    {stackGroups.map((g, gi) => (
                        <div class={`panel border-0 p-5 ${gi > 0 ? 'border-t md:border-t-0 md:border-l' : ''} border-[var(--line)]`}>
                            <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--fg-muted)] mb-3">▸ {L.sections[g.key]}</div>
                            <ul class="text-sm space-y-1.5">
                                {g.items.map((it: string) => (
                                    <li class="flex items-start gap-2 text-[var(--fg)]">
                                        <span class="text-[var(--green)] shrink-0">·</span>
                                        <span>{it}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            )}

            {codeHighlights.length > 0 && (
                <div class="space-y-4">
                    {codeHighlights.map((ch: any, i: number) => (
                        <div class="code-block border border-[var(--line)] bg-black" data-code-block>
                            <div class="px-4 py-2 border-b border-[var(--line)] text-[11px] text-[var(--fg-muted)] flex items-center justify-between gap-3">
                                <span class="truncate">{ch.file || ch.title || `snippet-${i + 1}`}</span>
                                <span class="flex items-center gap-3 shrink-0">
                                    {ch.lang && <span>{ch.lang}</span>}
                                    <button
                                        type="button"
                                        data-code-copy
                                        class="px-2 py-0.5 border border-[var(--line)] text-[var(--fg-muted)] hover:border-[var(--green)] hover:text-[var(--green)] transition-colors"
                                        aria-label="Copy code to clipboard"
                                    >[ copy ]</button>
                                </span>
                            </div>
                            {ch.note && <div class="px-4 py-2 border-b border-[var(--line)] text-xs text-[var(--fg-muted)]">// {ch.note}</div>}
                            <div class="shiki-wrap" set:html={ch.codeHtml || `<pre>${ch.code}</pre>`}></div>
                            <template data-code-source>{ch.code}</template>
                        </div>
                    ))}
                </div>
            )}
        </section>
    )}

    <!-- 06 · Technical Challenges (carousel) -->
    {project.techChallenges && project.techChallenges.length > 0 && (
        <section id="sec-challenges" class="mb-10 scroll-mt-20">
            <div class="border-b border-[var(--line)] pb-3 mb-5">
                <div class="text-xs text-[var(--fg-muted)] mb-1">// section 06 · {L.sections.techChallenges}</div>
                <h2 class="heading-mono text-2xl">
                    <span class="text-[var(--green)]">$</span> cat ./challenges/*.md
                </h2>
                <p class="mt-2 text-sm text-[var(--fg-dim)]">
                    <span class="text-[var(--fg-muted)]">// </span>{project.techChallenges.length} {lang === "es" ? "problemas tecnicos resueltos" : "technical problems solved"}
                </p>
            </div>

            <Carousel count={challenges.length} id="challenges">
                {challenges.map((ch: any, i: number) => (
                    <article data-carousel-slide class="w-full shrink-0">
                        <div class="window-chrome">
                            <div class="window-chrome-title">
                                {`challenge-${String(i + 1).padStart(2, '0')}.md`}{ch.tags && ch.tags.length > 0 ? `  ·  ${ch.tags.join(' · ')}` : ''}
                            </div>
                        </div>
                        <div class="p-5 md:p-7 space-y-4">
                            <div>
                                <div class="text-[10px] text-[var(--amber)] uppercase tracking-[0.15em] mb-2">▸ {L.sections.tcProblem}</div>
                                <h3 class="text-lg font-semibold text-[var(--fg)] leading-tight">{ch.problem}</h3>
                                {ch.constraint && (
                                    <p class="mt-2 text-sm text-[var(--fg-dim)]">
                                        <span class="text-[var(--fg-muted)]">{L.sections.tcConstraint}: </span>{ch.constraint}
                                    </p>
                                )}
                            </div>

                            <div class="grid md:grid-cols-2 gap-5 border-t border-[var(--line)] pt-4">
                                {ch.approach && (
                                    <div>
                                        <div class="text-[10px] text-[var(--cyan)] uppercase tracking-[0.15em] mb-2">▸ {L.sections.tcApproach}</div>
                                        <p class="text-sm text-[var(--fg)] leading-relaxed">{ch.approach}</p>
                                    </div>
                                )}
                                {ch.algorithm && (
                                    <div>
                                        <div class="text-[10px] text-[var(--cyan)] uppercase tracking-[0.15em] mb-2">▸ {L.sections.tcAlgorithm}</div>
                                        <p class="text-sm text-[var(--cyan-bright)] leading-relaxed">{ch.algorithm}</p>
                                    </div>
                                )}
                            </div>

                            {ch.code && (
                                <div class="code-block border border-[var(--line)] bg-black" data-code-block>
                                    <div class="px-4 py-2 border-b border-[var(--line)] text-[11px] text-[var(--fg-muted)] flex items-center justify-between gap-3">
                                        <span class="truncate">{ch.codeFile || `snippet-${i + 1}`}</span>
                                        <span class="flex items-center gap-3 shrink-0">
                                            {ch.codeLang && <span>{ch.codeLang}</span>}
                                            {ch.codeSandbox && (
                                                <button
                                                    type="button"
                                                    data-code-sandbox
                                                    data-sandbox-template={ch.codeSandbox}
                                                    data-sandbox-file={ch.codeFile || `snippet-${i + 1}.${ch.codeLang === "typescript" ? "ts" : "js"}`}
                                                    class="px-2 py-0.5 border border-[var(--line)] text-[var(--fg-muted)] hover:border-[var(--green)] hover:text-[var(--green)] transition-colors"
                                                    aria-label="Open in StackBlitz"
                                                >[ ▸ stackblitz ]</button>
                                            )}
                                            <button
                                                type="button"
                                                data-code-copy
                                                class="px-2 py-0.5 border border-[var(--line)] text-[var(--fg-muted)] hover:border-[var(--green)] hover:text-[var(--green)] transition-colors"
                                                aria-label="Copy code to clipboard"
                                            >[ copy ]</button>
                                        </span>
                                    </div>
                                    <div class="shiki-wrap" set:html={ch.codeHtml || `<pre>${ch.code}</pre>`}></div>
                                    <template data-code-source>{ch.code}</template>
                                </div>
                            )}

                            {ch.outcome && (
                                <div class="border-t border-[var(--line)] pt-3">
                                    <div class="text-[10px] text-[var(--green)] uppercase tracking-[0.15em] mb-2">▸ {L.sections.tcOutcome}</div>
                                    <p class="text-sm text-[var(--green)] leading-relaxed">{ch.outcome}</p>
                                </div>
                            )}
                        </div>
                    </article>
                ))}
            </Carousel>
        </section>
    )}

    <!-- 07 · Testing & CI -->
    {project.testing && (
        <section id="sec-testing" class="mb-10 scroll-mt-20">
            <div class="border-b border-[var(--line)] pb-3 mb-5">
                <div class="text-xs text-[var(--fg-muted)] mb-1">// section 07 · {L.sections.testing}</div>
                <h2 class="heading-mono text-2xl">
                    <span class="text-[var(--green)]">$</span> cat ./testing.md
                </h2>
            </div>
            <div class="grid md:grid-cols-3 gap-0 border border-[var(--line)]">
                {project.testing.strategy && (
                    <div class="panel border-0 p-6 md:col-span-2 md:border-r border-[var(--line)]">
                        <div class="text-xs text-[var(--fg-muted)] mb-3">▸ {L.sections.strategy}</div>
                        <p class="text-[var(--fg-dim)] text-sm leading-relaxed whitespace-pre-line">{project.testing.strategy}</p>
                    </div>
                )}
                <div class="panel border-0 p-6 border-t md:border-t-0 border-[var(--line)] space-y-4">
                    {project.testing.coverage && (
                        <div>
                            <div class="text-xs text-[var(--fg-muted)] mb-2">▸ {L.sections.coverage}</div>
                            <div class="heading-mono text-3xl text-[var(--green)]">{project.testing.coverage}</div>
                        </div>
                    )}
                    {project.testing.tools && (
                        <div>
                            <div class="text-xs text-[var(--fg-muted)] mb-2">▸ {L.sections.tools}</div>
                            <div class="flex flex-wrap gap-1.5">
                                {project.testing.tools.map((t: string) => (<span class="badge-mono">{t}</span>))}
                            </div>
                        </div>
                    )}
                </div>
            </div>
        </section>
    )}

    <!-- 07 · Screenshots -->
    {project.screenshots && project.screenshots.length > 0 && (
        <section id="sec-screenshots" class="mb-10 scroll-mt-20">
            <div class="border-b border-[var(--line)] pb-3 mb-5">
                <div class="text-xs text-[var(--fg-muted)] mb-1">// section 08 · {L.sections.screenshots}</div>
                <h2 class="heading-mono text-2xl">
                    <span class="text-[var(--green)]">$</span> ls ./{L.sections.screenshots}
                </h2>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-0 border border-[var(--line)]" data-lightbox-group>
                {project.screenshots.map((shot: any, i: number) => (
                    <a
                        href={shot.src}
                        data-lightbox-trigger
                        data-lightbox-src={shot.src}
                        data-lightbox-caption={`${project.title} — screenshot ${i + 1}`}
                        class={`group overflow-hidden bg-black cursor-zoom-in ${i > 0 ? 'border-t md:border-t-0 md:border-l border-[var(--line)]' : ''} ${i === 2 ? 'lg:border-l' : ''}`}
                    >
                        <Image
                            src={shot}
                            alt={`${project.title} ${L.sections.screenshots} ${i + 1}`}
                            class="w-full h-auto object-cover grayscale group-hover:grayscale-0 transition-all duration-300"
                            loading="lazy"
                            width={500}
                            height={320}
                            widths={[250, 500]}
                            sizes="(max-width: 768px) 100vw, 33vw"
                            formats={["avif", "webp"]}
                        />
                    </a>
                ))}
            </div>
        </section>
    )}

    <!-- 08 · Results -->
    {(project.metrics || project.results || project.challenges) && (
        <section id="sec-results" class="mb-10 scroll-mt-20">
            <div class="border-b border-[var(--line)] pb-3 mb-5">
                <div class="text-xs text-[var(--fg-muted)] mb-1">// section 09 · {L.sections.results}</div>
                <h2 class="heading-mono text-2xl">
                    <span class="text-[var(--green)]">$</span> cat ./{L.sections.results}.md
                </h2>
            </div>
            {project.metrics && (
                <div class={`grid grid-cols-2 ${metricsColsClass} gap-0 border border-[var(--line)] mb-6`}>
                    {project.metrics.map((m: any, i: number) => (
                        <div class={`p-6 ${i > 0 ? 'border-l border-[var(--line)]' : ''} ${i >= 2 ? 'border-t lg:border-t-0' : ''}`}>
                            <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--fg-muted)] mb-2">{String(i + 1).padStart(2, '0')} /</div>
                            <div class="heading-mono text-3xl text-[var(--green)] mb-2">{m.value}</div>
                            <div class="text-xs text-[var(--fg-dim)]">{m.label}</div>
                        </div>
                    ))}
                </div>
            )}
            {(project.results || project.challenges) && (
                <div class="grid md:grid-cols-2 gap-0 border border-[var(--line)]">
                    {project.challenges && (
                        <div class="panel border-0 p-6">
                            <div class="text-xs text-[var(--amber)] mb-3">▸ challenges</div>
                            <p class="text-[var(--fg-dim)] text-sm leading-relaxed">{project.challenges}</p>
                        </div>
                    )}
                    {project.results && (
                        <div class={`panel border-0 p-6 ${project.challenges ? 'border-t md:border-t-0 md:border-l' : ''} border-[var(--line)]`}>
                            <div class="text-xs text-[var(--green)] mb-3">▸ {L.sections.outcomes}</div>
                            <p class="text-[var(--fg-dim)] text-sm leading-relaxed">{project.results}</p>
                        </div>
                    )}
                </div>
            )}
        </section>
    )}

    <!-- 10 · Lessons learned -->
    {project.lessons && project.lessons.length > 0 && (
        <section id="sec-lessons" class="mb-10 scroll-mt-20">
            <div class="border-b border-[var(--line)] pb-3 mb-5">
                <div class="text-xs text-[var(--fg-muted)] mb-1">// section 10 · {L.sections.lessons}</div>
                <h2 class="heading-mono text-2xl">
                    <span class="text-[var(--green)]">$</span> cat ./lessons.md
                </h2>
                <p class="mt-2 text-sm text-[var(--fg-dim)]">
                    <span class="text-[var(--fg-muted)]">// </span>
                    {lang === "es" ? "si lo hiciera de nuevo" : "if I did it again"}
                </p>
            </div>
            <ul class="grid md:grid-cols-2 gap-0 border border-[var(--line)]">
                {project.lessons.map((lesson: any, i: number) => (
                    <li class={`panel border-0 p-5 md:p-6 ${i % 2 === 1 ? 'md:border-l' : ''} ${i >= 2 ? 'border-t' : ''} border-[var(--line)]`}>
                        <div class="flex items-baseline gap-3 mb-3">
                            <span class="text-[10px] uppercase tracking-[0.15em] text-[var(--fg-muted)] font-mono">{String(i + 1).padStart(2, '0')} /</span>
                            <h3 class="text-base font-semibold text-[var(--fg)] leading-tight">{lesson.title}</h3>
                        </div>
                        <p class="text-sm text-[var(--fg-dim)] leading-relaxed">{lesson.body}</p>
                    </li>
                ))}
            </ul>
        </section>
    )}

    <!-- Webmentions (hidden until at least one mention arrives) -->
    <section id="sec-webmentions" class="mb-10 hidden" data-webmentions>
        <div class="border-b border-[var(--line)] pb-3 mb-5">
            <div class="text-xs text-[var(--fg-muted)] mb-1">// {lang === "es" ? "menciones" : "mentions"}</div>
            <h2 class="heading-mono text-2xl">
                <span class="text-[var(--green)]">$</span> grep -r "this-url" ./web
            </h2>
            <p class="mt-2 text-sm text-[var(--fg-dim)]">
                <span class="text-[var(--fg-muted)]">// </span>
                {lang === "es" ? "respuestas, reposts y likes desde la web abierta" : "replies, reposts and likes from the open web"}
            </p>
        </div>

        <div class="grid md:grid-cols-[auto_1fr] gap-0 border border-[var(--line)]">
            <div class="panel border-0 p-5 md:border-r border-[var(--line)] min-w-[180px]">
                <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--fg-muted)] mb-3">▸ reactions</div>
                <div class="space-y-2 text-sm">
                    <div class="flex items-center gap-2">
                        <span class="text-[var(--amber)]">♡</span>
                        <span data-wm-likes class="text-[var(--fg)]">0</span>
                        <span class="text-[var(--fg-muted)] text-xs">likes</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-[var(--green)]">↻</span>
                        <span data-wm-reposts class="text-[var(--fg)]">0</span>
                        <span class="text-[var(--fg-muted)] text-xs">reposts</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-[var(--cyan)]">↩</span>
                        <span data-wm-replies class="text-[var(--fg)]">0</span>
                        <span class="text-[var(--fg-muted)] text-xs">replies</span>
                    </div>
                </div>
            </div>
            <div class="panel border-0 border-t md:border-t-0 p-5 border-[var(--line)]">
                <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--fg-muted)] mb-3">▸ replies & mentions</div>
                <ul data-wm-list class="space-y-3 text-sm"></ul>
            </div>
        </div>
    </section>

    <!-- Related projects -->
    {related.length > 0 && (
        <section class="mb-10">
            <div class="border-b border-[var(--line)] pb-3 mb-5">
                <div class="text-xs text-[var(--fg-muted)] mb-1">// {lang === "es" ? "relacionados" : "related"}</div>
                <h2 class="heading-mono text-2xl">
                    <span class="text-[var(--green)]">$</span> grep -l "tech" ./projects/*
                </h2>
                <p class="mt-2 text-sm text-[var(--fg-dim)]">
                    <span class="text-[var(--fg-muted)]">// </span>
                    {lang === "es" ? "proyectos que comparten parte del stack" : "projects that share part of the stack"}
                </p>
            </div>
            <div class={`grid grid-cols-1 ${related.length >= 3 ? 'md:grid-cols-3' : related.length === 2 ? 'md:grid-cols-2' : ''} gap-0 border border-[var(--line)]`}>
                {related.map((r: any, i: number) => {
                    const shared = (project.tech || []).filter((t: string) => (r.tech || []).includes(t));
                    return (
                        <a
                            href={`${projectsBase}/${r.slug}`}
                            class={`group panel border-0 p-5 hover:bg-[var(--bg-elev)]/40 transition-colors ${i > 0 ? 'border-t md:border-t-0 md:border-l border-[var(--line)]' : ''}`}
                        >
                            <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--fg-muted)] mb-2">
                                {String(i + 1).padStart(2, '0')} / related
                            </div>
                            <h3 class="text-base font-semibold text-[var(--fg)] group-hover:text-[var(--green)] transition-colors leading-tight mb-2">
                                {r.title}
                            </h3>
                            <p class="text-xs text-[var(--fg-dim)] line-clamp-2 mb-3">{r.description}</p>
                            <div class="flex flex-wrap gap-1">
                                {shared.slice(0, 3).map((t: string) => (
                                    <span class="badge-mono">{t}</span>
                                ))}
                            </div>
                        </a>
                    );
                })}
            </div>
        </section>
    )}

    <!-- Prev / next nav -->
    {(prev || next) && (
        <nav class="grid md:grid-cols-2 gap-0 border border-[var(--line)] mb-10" aria-label="Project navigation">
            {prev ? (
                <a
                    href={`${projectsBase}/${prev.slug}`}
                    class="group panel border-0 p-5 md:p-6 hover:bg-[var(--bg-elev)]/40 transition-colors"
                >
                    <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--fg-muted)] mb-2 flex items-center gap-2">
                        <span class="text-[var(--green)] group-hover:-translate-x-1 transition-transform">◂</span>
                        <span>{L.sections.navPrev}</span>
                    </div>
                    <div class="text-base font-semibold text-[var(--fg)] group-hover:text-[var(--green)] transition-colors leading-tight">
                        {prev.title}
                    </div>
                    <div class="text-xs text-[var(--fg-muted)] font-mono mt-1">{prev.slug}</div>
                </a>
            ) : <div class="hidden md:block panel border-0"></div>}

            {next ? (
                <a
                    href={`${projectsBase}/${next.slug}`}
                    class={`group panel border-0 p-5 md:p-6 text-right hover:bg-[var(--bg-elev)]/40 transition-colors ${prev ? 'border-t md:border-t-0 md:border-l border-[var(--line)]' : ''}`}
                >
                    <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--fg-muted)] mb-2 flex items-center justify-end gap-2">
                        <span>{L.sections.navNext}</span>
                        <span class="text-[var(--green)] group-hover:translate-x-1 transition-transform">▸</span>
                    </div>
                    <div class="text-base font-semibold text-[var(--fg)] group-hover:text-[var(--green)] transition-colors leading-tight">
                        {next.title}
                    </div>
                    <div class="text-xs text-[var(--fg-muted)] font-mono mt-1">{next.slug}</div>
                </a>
            ) : <div class="hidden md:block panel border-0"></div>}
        </nav>
    )}

    <!-- CTA -->
    <section class="panel-accent p-8 md:p-10 text-center">
        <div class="text-xs text-[var(--fg-muted)] mb-3">// {L.sections.nextStep}</div>
        <h3 class="heading-mono text-2xl mb-3">
            <span class="text-[var(--green)]">$</span> {L.sections.ctaTitle}
        </h3>
        <p class="text-[var(--fg-dim)] mb-6 text-sm">
            <span class="text-[var(--fg-muted)]">// </span>{L.sections.ctaSub}
        </p>
        <a href={contactHref} class="btn-cli btn-cli--primary">
            <span>{L.sections.letsTalk}</span>
        </a>
    </section>

    </div><!-- /lg:order-2 content column -->

</div>

<script>
    // ============ GitHub live stats ============
    function timeAgo(iso: string): string {
        const seconds = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
        const intervals: Array<[number, string]> = [
            [86400 * 365, "y"],
            [86400 * 30, "mo"],
            [86400 * 7, "w"],
            [86400, "d"],
            [3600, "h"],
            [60, "m"],
        ];
        for (const [secs, label] of intervals) {
            const v = Math.floor(seconds / secs);
            if (v >= 1) return `${v}${label} ago`;
        }
        return "just now";
    }

    document.querySelectorAll<HTMLElement>("[data-gh-stats]").forEach(async (panel) => {
        const url = panel.getAttribute("data-gh-url");
        if (!url) return;
        const m = url.match(/github\.com\/([^/]+)\/([^/?#]+)/i);
        if (!m) return;
        const [, owner, repo] = m;
        try {
            const res = await fetch(`https://api.github.com/repos/${owner}/${repo.replace(/\.git$/, "")}`);
            if (!res.ok) throw new Error(String(res.status));
            const data = await res.json();
            const stars = panel.querySelector("[data-gh-stars]");
            const forks = panel.querySelector("[data-gh-forks]");
            const pushed = panel.querySelector("[data-gh-pushed]");
            if (stars) stars.textContent = String(data.stargazers_count ?? 0);
            if (forks) forks.textContent = String(data.forks_count ?? 0);
            if (pushed && data.pushed_at) pushed.textContent = timeAgo(data.pushed_at);
            panel.querySelectorAll<HTMLElement>(".gh-stat").forEach((s) => s.classList.remove("opacity-50"));
        } catch {
            // repo private / 404 / rate-limited — just leave the dashes and dim style
        }
    });

    // Open snippet in StackBlitz (POST API)
    document.querySelectorAll<HTMLButtonElement>("[data-code-sandbox]").forEach((btn) => {
        btn.addEventListener("click", () => {
            const block = btn.closest<HTMLElement>("[data-code-block]");
            const source = block?.querySelector<HTMLTemplateElement>("[data-code-source]")?.content?.textContent ?? "";
            const template = btn.getAttribute("data-sandbox-template") || "typescript";
            const filename = btn.getAttribute("data-sandbox-file") || "snippet.ts";

            const form = document.createElement("form");
            form.action = "https://stackblitz.com/run";
            form.method = "POST";
            form.target = "_blank";
            form.style.display = "none";

            const addField = (name: string, value: string) => {
                const i = document.createElement("input");
                i.type = "hidden";
                i.name = name;
                i.value = value;
                form.appendChild(i);
            };

            addField("project[template]", template);
            addField("project[title]", `Snippet · ${filename}`);
            addField("project[description]", "Opened from automata.pe");
            addField(`project[files][${filename}]`, source);

            document.body.appendChild(form);
            form.submit();
            form.remove();
        });
    });

    // Copy code-block source to clipboard
    document.querySelectorAll<HTMLButtonElement>("[data-code-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
            const block = btn.closest<HTMLElement>("[data-code-block]");
            const source = block?.querySelector<HTMLTemplateElement>("[data-code-source]")?.content?.textContent ?? "";
            try {
                await navigator.clipboard.writeText(source);
                btn.textContent = "[ copied ]";
                btn.classList.add("text-[var(--green)]", "border-[var(--green)]");
                setTimeout(() => {
                    btn.textContent = "[ copy ]";
                    btn.classList.remove("text-[var(--green)]", "border-[var(--green)]");
                }, 1500);
            } catch {
                btn.textContent = "[ failed ]";
                setTimeout(() => { btn.textContent = "[ copy ]"; }, 1500);
            }
        });
    });

    // ============ Webmentions ============
    // Fetch mentions for the current URL from webmention.io. If at least one
    // arrives, surface the section. Silent otherwise.
    (async () => {
        const section = document.getElementById("sec-webmentions");
        if (!section) return;
        const target = `${location.origin}${location.pathname}`;
        try {
            const res = await fetch(
                `https://webmention.io/api/mentions.jf2?target=${encodeURIComponent(target)}&per-page=50`,
                { mode: "cors" }
            );
            if (!res.ok) return;
            const data = await res.json();
            const children: any[] = data?.children ?? [];
            if (children.length === 0) return;

            const likes = children.filter((c) => c["wm-property"] === "like-of");
            const reposts = children.filter((c) => c["wm-property"] === "repost-of");
            const replies = children.filter((c) =>
                ["in-reply-to", "mention-of"].includes(c["wm-property"])
            );

            (section.querySelector("[data-wm-likes]") as HTMLElement).textContent = String(likes.length);
            (section.querySelector("[data-wm-reposts]") as HTMLElement).textContent = String(reposts.length);
            (section.querySelector("[data-wm-replies]") as HTMLElement).textContent = String(replies.length);

            const list = section.querySelector("[data-wm-list]") as HTMLElement;
            list.innerHTML = "";
            replies.slice(0, 10).forEach((m) => {
                const li = document.createElement("li");
                const name = m.author?.name ?? "anon";
                const url = m.url ?? "#";
                const content = (m.content?.text ?? m.summary ?? "").slice(0, 240);
                const when = m.published ? new Date(m.published).toISOString().slice(0, 10) : "";
                li.innerHTML = `
                    <a href="${url}" target="_blank" rel="noopener noreferrer" class="block p-3 border border-[var(--line)] hover:border-[var(--green)] transition-colors">
                        <div class="flex items-center justify-between mb-1 text-xs">
                            <span class="text-[var(--green)]">▸ ${name.replace(/[<>]/g, "")}</span>
                            <span class="text-[var(--fg-muted)] font-mono">${when}</span>
                        </div>
                        <div class="text-[13px] text-[var(--fg-dim)] line-clamp-3">${content.replace(/[<>]/g, "")}</div>
                    </a>
                `;
                list.appendChild(li);
            });

            section.classList.remove("hidden");
        } catch (err) {
            // Network failure, CORS issue, or webmention.io not configured for this domain — silent.
        }
    })();

    // ============ Section permalinks ============
    // For every <section id="..."> in the page, find its first heading and add a copy-link button.
    document.querySelectorAll<HTMLElement>("section[id]").forEach((section) => {
        const id = section.id;
        if (!id) return;
        const heading = section.querySelector<HTMLElement>("h2, h3");
        if (!heading) return;
        heading.setAttribute("data-section-permalink", "");
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "permalink-btn";
        btn.textContent = "#";
        btn.setAttribute("aria-label", `Copy link to ${id}`);
        btn.addEventListener("click", async (e) => {
            e.preventDefault();
            const url = `${location.origin}${location.pathname}#${id}`;
            try {
                await navigator.clipboard.writeText(url);
                btn.setAttribute("data-copied", "true");
                history.replaceState(null, "", `#${id}`);
                setTimeout(() => btn.removeAttribute("data-copied"), 1200);
            } catch {
                // fallback: focus the section
                section.scrollIntoView({ behavior: "smooth" });
            }
        });
        heading.appendChild(btn);
    });
</script>
