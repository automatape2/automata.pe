---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl } from "../i18n/utils";
import { translations } from "../i18n/translations";

const lang = getLangFromUrl(Astro.url);
const homeHref = lang === "es" ? "/" : "/en";
const requested = Astro.url.pathname || "/";
const projectsBase = lang === "es" ? "/es/projects" : "/projects";

// Known project slugs, surfaced to the client for fuzzy "did you mean?".
const slugs = (translations[lang] as any).solutions.items.map((p: any) => ({
    slug: p.slug,
    title: p.title,
}));

const L = lang === "es"
    ? {
          title: "404 | Automata",
          stamp: "EXIT CODE 404",
          message: "no se encontro ningun archivo en esta ruta.",
          tip: "intenta abrir el palette con Cmd/Ctrl + K para buscar un proyecto o seccion.",
          home: "./volver-al-inicio.sh",
          projects: "ls ./proyectos",
      }
    : {
          title: "404 | Automata",
          stamp: "EXIT CODE 404",
          message: "no file found at this path.",
          tip: "try opening the palette with Cmd/Ctrl + K to search projects or sections.",
          home: "./back-home.sh",
          projects: "ls ./projects",
      };
---

<Layout title={L.title} ogType="website">
    <div class="max-w-3xl mx-auto px-6 py-24 lg:py-32">
        <div class="text-xs text-[var(--fg-muted)] mb-3">
            <span class="inline-flex items-center gap-2">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--red)]"></span>
                {L.stamp}
            </span>
        </div>

        <h1 class="heading-mono text-[clamp(2.5rem,8vw,5rem)] mb-6">
            <span class="text-[var(--red)]">4</span><span class="text-[var(--green)]">0</span><span class="text-[var(--red)]">4</span>
        </h1>

        <div class="panel mb-8">
            <div class="window-chrome">
                <div class="window-chrome-title">automata@latam: ~{requested}</div>
            </div>
            <div class="p-5 md:p-7 font-mono text-[13px] leading-[1.7] space-y-1">
                <div><span class="text-[var(--green)]">$</span> <span class="text-[var(--fg)]">cd {requested}</span></div>
                <div class="text-[var(--red)]">cd: {requested}: no such file or directory</div>
                <div class="pt-2"><span class="text-[var(--green)]">$</span> <span class="text-[var(--fg)]">git log {requested}</span></div>
                <div class="text-[var(--fg-muted)]">fatal: ambiguous argument '{requested}': unknown revision or path not in the working tree.</div>
                <div class="pt-2"><span class="text-[var(--green)]">$</span> <span class="text-[var(--fg)]">echo $?</span></div>
                <div class="text-[var(--amber)]">404</div>
                <div class="pt-3 text-[var(--fg-dim)]">
                    <span class="text-[var(--fg-muted)]">// </span>{L.message}
                </div>
                <div class="text-[var(--fg-dim)]">
                    <span class="text-[var(--fg-muted)]">// </span>{L.tip}
                </div>
            </div>
        </div>

        <!-- Fuzzy "did you mean?" — filled by JS when the path looks like a project slug -->
        <div id="did-you-mean" class="hidden panel p-5 mb-8 border border-[var(--line)]">
            <div class="text-xs text-[var(--fg-muted)] mb-3">
                <span class="text-[var(--amber)]">?</span> {lang === "es" ? "quisiste decir" : "did you mean"}:
            </div>
            <ul id="dym-list" class="space-y-1 text-sm font-mono"></ul>
        </div>

        <div class="flex flex-wrap gap-3">
            <a href={homeHref} class="btn-cli btn-cli--primary">
                <span>{L.home}</span>
            </a>
            <a href={`${homeHref}#solutions`} class="btn-cli">
                <span>{L.projects}</span>
            </a>
        </div>
    </div>

    <script is:inline define:vars={{ slugs, projectsBase, requested }}>
        (function () {
            // Levenshtein distance for fuzzy matching the requested path's last segment.
            function lev(a, b) {
                const m = a.length, n = b.length;
                const d = Array.from({ length: m + 1 }, (_, i) => [i, ...Array(n).fill(0)]);
                for (let j = 0; j <= n; j++) d[0][j] = j;
                for (let i = 1; i <= m; i++)
                    for (let j = 1; j <= n; j++)
                        d[i][j] = Math.min(
                            d[i - 1][j] + 1,
                            d[i][j - 1] + 1,
                            d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1)
                        );
                return d[m][n];
            }

            const seg = (requested.split("/").filter(Boolean).pop() || "").toLowerCase();
            if (!seg) return;

            const ranked = slugs
                .map((s) => ({ ...s, dist: lev(seg, s.slug.toLowerCase()) }))
                .filter((s) => s.dist <= Math.max(3, Math.floor(s.slug.length * 0.5)))
                .sort((a, b) => a.dist - b.dist)
                .slice(0, 3);

            if (ranked.length === 0) return;

            const list = document.getElementById("dym-list");
            ranked.forEach((s) => {
                const li = document.createElement("li");
                li.innerHTML =
                    '<a href="' + projectsBase + "/" + s.slug + '" class="inline-flex items-center gap-2 text-[var(--fg-dim)] hover:text-[var(--green)] transition-colors">' +
                    '<span class="text-[var(--green)]">▸</span>' +
                    "<span>" + s.title + '</span>' +
                    '<span class="text-[var(--fg-muted)] text-xs">' + projectsBase + "/" + s.slug + "</span>" +
                    "</a>";
                list.appendChild(li);
            });
            document.getElementById("did-you-mean").classList.remove("hidden");
        })();
    </script>
</Layout>
