---
import { Image } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
    const { translations } = await import("../../../i18n/translations.ts");
    return translations.es.solutions.items.map((project: any) => ({
        params: { slug: project.slug },
        props: { project, locale: "es" },
    }));
}

const { project, locale } = Astro.props;
const backHref = "/es#solutions";
const backLabel = "cd ..  // volver a proyectos";

const typeLabel: Record<string, string> = {
    producto: "PRODUCTO",
    product: "PRODUCTO",
    caso: "CASO DE USO",
    case: "CASO DE USO",
};
---

<Layout title={`${project.title} | Automata`}>
    <div class="max-w-6xl mx-auto px-6 lg:px-12 py-12">
        <a href={backHref} class="inline-flex items-center gap-2 text-sm text-[var(--fg-muted)] hover:text-[var(--green)] transition-colors mb-8 group">
            <span class="text-[var(--green)]">$</span>
            <span>{backLabel}</span>
            <span class="text-[var(--green)] opacity-0 group-hover:opacity-100 transition-opacity">←</span>
        </a>

        <div class="panel mb-10">
            <div class="window-chrome">
                <div class="window-chrome-title">automata@latam: ~/proyectos/{project.slug}</div>
            </div>
            <div class="p-6 md:p-10 grid lg:grid-cols-[1.3fr_1fr] gap-10 items-start">
                <div class="space-y-5">
                    <div class="flex items-center gap-3 text-xs text-[var(--fg-muted)]">
                        <span class="inline-flex items-center gap-1.5 px-2 py-1 border border-[var(--line-bright)] text-[var(--green)]">
                            <span class="w-1 h-1 rounded-full bg-[var(--green)]"></span>
                            {typeLabel[project.type] || project.type}
                        </span>
                        <span class="text-[var(--line-bright)]">·</span>
                        <span class="font-mono">slug: {project.slug}</span>
                    </div>

                    <h1 class="heading-mono text-[clamp(2rem,5vw,3.5rem)] text-[var(--fg)]">
                        <span class="text-[var(--green)]">{'>'}</span> {project.title}
                    </h1>

                    <p class="text-[var(--fg-dim)] text-base leading-relaxed max-w-xl">
                        <span class="text-[var(--fg-muted)]">// </span>{project.description}
                    </p>

                    <div class="flex flex-wrap gap-2 pt-2">
                        {project.tech.map((tech: string) => (
                            <span class="badge-mono">{tech}</span>
                        ))}
                    </div>

                    {project.demoUrl && (
                        <div class="pt-4">
                            <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn-cli btn-cli--primary">
                                <span>./abrir-demo --live</span>
                            </a>
                        </div>
                    )}
                </div>

                <div class="border border-[var(--line)] bg-black overflow-hidden">
                    <Image
                        src={project.image}
                        alt={project.title}
                        class="w-full h-auto object-cover"
                        loading="eager"
                        width={720}
                        height={480}
                        format="webp"
                    />
                </div>
            </div>
        </div>

        <div class="grid md:grid-cols-2 gap-0 border border-[var(--line)] mb-10">
            <div class="panel border-0 p-6">
                <div class="text-xs text-[var(--fg-muted)] mb-3">// spec</div>
                <dl class="text-sm space-y-2">
                    <div class="flex gap-3">
                        <dt class="text-[var(--fg-muted)] w-24 shrink-0">tipo</dt>
                        <dd class="text-[var(--fg)]">{typeLabel[project.type] || project.type}</dd>
                    </div>
                    <div class="flex gap-3">
                        <dt class="text-[var(--fg-muted)] w-24 shrink-0">stack</dt>
                        <dd class="text-[var(--fg)]">{project.tech.join(" · ")}</dd>
                    </div>
                    {project.demoUrl && (
                        <div class="flex gap-3">
                            <dt class="text-[var(--fg-muted)] w-24 shrink-0">demo</dt>
                            <dd>
                                <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="link-mono text-[var(--green)]">
                                    {project.demoUrl.replace(/^https?:\/\//, "")}
                                </a>
                            </dd>
                        </div>
                    )}
                </dl>
            </div>

            <div class="panel border-0 border-t md:border-t-0 md:border-l border-[var(--line)] p-6">
                <div class="text-xs text-[var(--fg-muted)] mb-3">// estado</div>
                <ul class="text-sm space-y-1.5 font-mono">
                    <li class="text-[var(--fg-muted)]">[OK]  build .................... <span class="text-[var(--green)]">listo</span></li>
                    <li class="text-[var(--fg-muted)]">[OK]  demo en vivo ............. <span class="text-[var(--green)]">{project.demoUrl ? "online" : "n/a"}</span></li>
                    <li class="text-[var(--fg-muted)]">[OK]  caso de estudio .......... <span class="text-[var(--amber)]">borrador</span></li>
                </ul>
            </div>
        </div>

        {project.screenshots && project.screenshots.length > 0 && (
            <section class="mb-12">
                <div class="border-b border-[var(--line)] pb-4 mb-6">
                    <div class="text-xs text-[var(--fg-muted)] mb-1">// seccion 01</div>
                    <h2 class="heading-mono text-2xl">
                        <span class="text-[var(--green)]">$</span> ls ./capturas
                    </h2>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-0 border border-[var(--line)]">
                    {project.screenshots.map((shot: any, i: number) => (
                        <a href={shot.src} target="_blank" rel="noopener noreferrer" class={`group overflow-hidden bg-black ${i > 0 ? 'border-t md:border-t-0 md:border-l border-[var(--line)]' : ''} ${i === 2 ? 'lg:border-l' : ''}`}>
                            <Image
                                src={shot}
                                alt={`${project.title} captura ${i + 1}`}
                                class="w-full h-auto object-cover grayscale group-hover:grayscale-0 transition-all duration-300"
                                loading="lazy"
                                width={500}
                                height={320}
                                format="webp"
                            />
                        </a>
                    ))}
                </div>
            </section>
        )}

        <section class="mb-12">
            <div class="border-b border-[var(--line)] pb-4 mb-6">
                <div class="text-xs text-[var(--fg-muted)] mb-1">// seccion 02</div>
                <h2 class="heading-mono text-2xl">
                    <span class="text-[var(--green)]">$</span> cat ./descripcion.md
                </h2>
            </div>
            <div class="panel p-6 md:p-8">
                <p class="text-[var(--fg-dim)] leading-relaxed">
                    {project.fullDescription || (
                        <span class="text-[var(--fg-muted)]">// TODO: agregar <code class="text-[var(--amber)]">fullDescription</code> en translations.es.solutions.items[{project.slug}]</span>
                    )}
                </p>
            </div>
        </section>

        {project.features && project.features.length > 0 ? (
            <section class="mb-12">
                <div class="border-b border-[var(--line)] pb-4 mb-6">
                    <div class="text-xs text-[var(--fg-muted)] mb-1">// seccion 03</div>
                    <h2 class="heading-mono text-2xl">
                        <span class="text-[var(--green)]">$</span> cat ./caracteristicas.txt
                    </h2>
                </div>
                <ul class="grid md:grid-cols-2 gap-0 border border-[var(--line)]">
                    {project.features.map((feature: string, i: number) => (
                        <li class={`flex items-start gap-3 p-4 ${i % 2 === 1 ? 'md:border-l border-[var(--line)]' : ''} ${i >= 2 ? 'border-t border-[var(--line)]' : ''}`}>
                            <span class="text-[var(--green)] shrink-0 mt-0.5">▸</span>
                            <span class="text-sm text-[var(--fg)]">{feature}</span>
                        </li>
                    ))}
                </ul>
            </section>
        ) : (
            <section class="mb-12 opacity-60">
                <div class="border-b border-[var(--line)] pb-4 mb-6">
                    <div class="text-xs text-[var(--fg-muted)] mb-1">// seccion 03</div>
                    <h2 class="heading-mono text-2xl text-[var(--fg-muted)]">
                        <span class="text-[var(--green)]">$</span> cat ./caracteristicas.txt
                    </h2>
                </div>
                <div class="panel p-6 text-sm text-[var(--fg-muted)]">
                    // TODO: agregar <code class="text-[var(--amber)]">features: string[]</code> en translations.es.solutions.items[{project.slug}]
                </div>
            </section>
        )}

        <section class="mb-12 grid md:grid-cols-2 gap-0 border border-[var(--line)]">
            <div class="panel border-0 p-6 md:p-8">
                <div class="text-xs text-[var(--fg-muted)] mb-3">// seccion 04 · desafios</div>
                <h3 class="heading-mono text-lg mb-4 text-[var(--amber)]">$ cat ./desafios.md</h3>
                <p class="text-[var(--fg-dim)] text-sm leading-relaxed">
                    {project.challenges || (
                        <span class="text-[var(--fg-muted)]">// TODO: agregar <code class="text-[var(--amber)]">challenges</code></span>
                    )}
                </p>
            </div>
            <div class="panel border-0 border-t md:border-t-0 md:border-l border-[var(--line)] p-6 md:p-8">
                <div class="text-xs text-[var(--fg-muted)] mb-3">// seccion 05 · resultados</div>
                <h3 class="heading-mono text-lg mb-4 text-[var(--green)]">$ cat ./resultados.md</h3>
                <p class="text-[var(--fg-dim)] text-sm leading-relaxed">
                    {project.results || (
                        <span class="text-[var(--fg-muted)]">// TODO: agregar <code class="text-[var(--green)]">results</code></span>
                    )}
                </p>
            </div>
        </section>

        <section class="panel-accent p-8 md:p-10 text-center">
            <div class="text-xs text-[var(--fg-muted)] mb-3">// siguiente paso</div>
            <h3 class="heading-mono text-2xl mb-3">
                <span class="text-[var(--green)]">$</span> automata deploy --tu-operacion
            </h3>
            <p class="text-[var(--fg-dim)] mb-6 text-sm">
                <span class="text-[var(--fg-muted)]">// </span>
                Conversemos sobre como adaptamos esto a tu caso.
            </p>
            <a href="/es#contact" class="btn-cli btn-cli--primary">
                <span>./contactar.sh</span>
            </a>
        </section>
    </div>
</Layout>
