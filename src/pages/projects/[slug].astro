---
import Layout from "../../layouts/Layout.astro";
import ProjectDetail from "../../components/ProjectDetail.astro";

export async function getStaticPaths() {
    const { translations } = await import("../../i18n/translations.ts");
    const items = translations.en.solutions.items;
    return items.map((project: any, i: number) => ({
        params: { slug: project.slug },
        props: {
            project,
            prev: i > 0 ? items[i - 1] : null,
            next: i < items.length - 1 ? items[i + 1] : null,
        },
    }));
}

const { project, prev, next } = Astro.props;
const ogImage = project.image?.src;
---

<Layout
    title={`${project.title} | Automata`}
    description={project.description}
    ogImage={ogImage}
    ogType="article"
>
    <ProjectDetail project={project} lang="en" prev={prev} next={next} />
</Layout>
