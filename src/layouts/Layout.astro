---
import "../styles/global.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import Footer from "../components/Footer.astro";
import VisitTracker from "../components/VisitTracker.astro";
import CommandPalette from "../components/CommandPalette.astro";
import KeyboardHelp from "../components/KeyboardHelp.astro";
import Lightbox from "../components/Lightbox.astro";
import { getLangFromUrl, getTranslations } from "../i18n/utils";
import { personalInfo } from "../config/personal";
import { translations } from "../i18n/translations";

interface Props {
    title: string;
    /** Page-specific description for SEO / social cards. Falls back to a brand default. */
    description?: string;
    /** Absolute or root-relative path to the social preview image (1200x630 ideal). */
    ogImage?: string;
    /** "website" for landing, "article" for case studies. Defaults to "website". */
    ogType?: "website" | "article";
    /** Optional JSON-LD structured data (any schema.org type). Replaces the default Organization payload. */
    structuredData?: Record<string, any>;
}

const {
    title,
    description: pageDescription,
    ogImage = "/favicon.svg",
    ogType = "website",
    structuredData,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const homeHref = lang === "es" ? "/" : "/en";

// Compute alternate-language URL for the current path so we can emit hreflang tags.
// /            ↔ /es        (root defaults to en)
// /en          ↔ /es
// /es          ↔ /en
// /projects/x  ↔ /es/projects/x
// /es/projects/x ↔ /projects/x
function altPathFor(pathname: string): { en: string; es: string } {
    let cleaned = pathname.replace(/\/+$/, "") || "/";
    // Strip leading /en or /es
    const stripped = cleaned.replace(/^\/(en|es)(?=\/|$)/, "") || "/";
    const en = stripped === "/" ? "/en" : stripped;
    const es = stripped === "/" ? "/es" : `/es${stripped}`;
    return { en, es };
}
const alts = altPathFor(Astro.url.pathname);
const siteBase = (Astro.site || Astro.url).toString().replace(/\/+$/, "");
const altEn = `${siteBase}${alts.en}`;
const altEs = `${siteBase}${alts.es}`;

const projectsBase = lang === "es" ? "/es/projects" : "/projects";
const langItems = (translations[lang] as any).solutions.items as any[];
const cmdkCommands = [
    { label: lang === "es" ? "Inicio" : "Home", href: homeHref, tag: "page" },
    { label: t.nav.solutions, href: `${homeHref}#solutions`, tag: "section" },
    { label: t.nav.services, href: `${homeHref}#services`, tag: "section" },
    { label: t.nav.tech, href: `${homeHref}#tech`, tag: "section" },
    { label: t.nav.contact, href: `${homeHref}#contact`, tag: "section" },
    ...langItems.map((p: any) => ({
        label: p.title,
        sublabel: p.slug,
        href: `${projectsBase}/${p.slug}`,
        tag: "project",
    })),
];

const defaultDescription = lang === "es"
    ? "Automata — Tecnologia que opera contigo. Consultoria, software, cloud, IoT y automatizacion para empresas que necesitan continuidad operativa."
    : "Automata — Technology that operates with you. Consulting, software, cloud, IoT and automation for businesses that need operational continuity.";
const description = pageDescription || defaultDescription;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url).toString();
const absoluteOgImage = ogImage.startsWith("http")
    ? ogImage
    : new URL(ogImage, Astro.site || Astro.url).toString();

const orgSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: personalInfo.brandName,
    url: (Astro.site || Astro.url).toString(),
    logo: new URL("/favicon.svg", Astro.site || Astro.url).toString(),
    description: defaultDescription,
    sameAs: [
        personalInfo.socialLinks.github,
        personalInfo.socialLinks.linkedin,
        personalInfo.socialLinks.twitter,
    ].filter(Boolean),
};

// Default JSON-LD: for landing → Organization; for articles → WebPage if caller didn't supply one.
const ldPayload = structuredData ?? (
    ogType === "article"
        ? {
              "@context": "https://schema.org",
              "@type": "WebPage",
              name: title,
              description,
              url: canonical,
              inLanguage: lang === "es" ? "es-PE" : "en-US",
              isPartOf: { "@type": "WebSite", name: personalInfo.brandName, url: (Astro.site || Astro.url).toString() },
          }
        : orgSchema
);
---

<!doctype html>
<html lang={lang} class="lenis lenis-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={canonical} />

        <!-- hreflang: tell search engines about the EN ↔ ES counterparts -->
        <link rel="alternate" hreflang="en" href={altEn} />
        <link rel="alternate" hreflang="es" href={altEs} />
        <link rel="alternate" hreflang="x-default" href={altEn} />

        <link rel="alternate" type="application/rss+xml" title="Automata Projects" href="/rss.xml" />
        <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
        <meta name="generator" content={Astro.generator} />

        <!-- JSON-LD structured data -->
        <script type="application/ld+json" is:inline set:html={JSON.stringify(ldPayload)}></script>

        <!-- Open Graph -->
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={personalInfo.brandName} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={absoluteOgImage} />
        <meta property="og:image:alt" content={title} />
        <meta property="og:locale" content={lang === "es" ? "es_PE" : "en_US"} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={absoluteOgImage} />
        {personalInfo.socialUsernames.twitter && (
            <meta name="twitter:site" content={personalInfo.socialUsernames.twitter} />
        )}

        <!-- PWA Manifest -->
        <link rel="manifest" href="/manifest.json" />

        <!-- Theme Color for mobile browsers -->
        <meta name="theme-color" content="#000000" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

        <!-- Preconnect to improve performance -->
        <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

        <!-- Critical CSS - Inline for instant render -->
        <style is:inline>
            html { scroll-behavior: smooth; }
            body {
                margin: 0;
                background: #000;
                color: #E5E7EB;
                font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            }
            header {
                position: fixed;
                top: 0;
                width: 100%;
                z-index: 50;
            }
            main { padding-top: 4rem; }
            [data-animate] { opacity: 0; }
        </style>

        <title>{title}</title>
    </head>
    <body class="bg-terminal">
        <!-- Grid backdrop -->
        <div class="fixed inset-0 -z-10 bg-grid pointer-events-none"></div>

        <!-- Header: bracketed CLI nav -->
        <header class="border-b border-[var(--line)] bg-black/80 backdrop-blur">
            <nav class="mx-auto max-w-7xl px-6 h-14 flex items-center justify-between">
                <a href={homeHref} class="flex items-center gap-2 text-sm group">
                    <span class="text-[var(--green)]">$</span>
                    <span class="font-bold tracking-tight text-[var(--fg)] group-hover:text-[var(--green)] transition-colors">
                        {personalInfo.brandName.toLowerCase()}
                    </span>
                    <span class="text-[var(--fg-muted)]">--init</span>
                </a>

                <div class="flex items-center gap-1">
                    <ul class="hidden md:flex items-center text-sm">
                        <li>
                            <a href="#solutions" class="px-3 py-2 text-[var(--fg-dim)] hover:text-[var(--green)] transition-colors flex items-center gap-1.5">
                                <span class="text-[var(--fg-muted)]">01</span>
                                <span>{t.nav.solutions}</span>
                            </a>
                        </li>
                        <li>
                            <a href="#services" class="px-3 py-2 text-[var(--fg-dim)] hover:text-[var(--green)] transition-colors flex items-center gap-1.5">
                                <span class="text-[var(--fg-muted)]">02</span>
                                <span>{t.nav.services}</span>
                            </a>
                        </li>
                        <li>
                            <a href="#tech" class="px-3 py-2 text-[var(--fg-dim)] hover:text-[var(--green)] transition-colors flex items-center gap-1.5">
                                <span class="text-[var(--fg-muted)]">03</span>
                                <span>{t.nav.tech}</span>
                            </a>
                        </li>
                        <li>
                            <a href="#contact" class="px-3 py-2 text-[var(--fg-dim)] hover:text-[var(--green)] transition-colors flex items-center gap-1.5">
                                <span class="text-[var(--fg-muted)]">04</span>
                                <span>{t.nav.contact}</span>
                            </a>
                        </li>
                    </ul>
                    <button
                        type="button"
                        id="cmdk-trigger"
                        class="hidden md:inline-flex items-center gap-1.5 px-2 py-1 text-[11px] text-[var(--fg-muted)] border border-[var(--line)] hover:border-[var(--green)] hover:text-[var(--green)] transition-colors mr-2 font-mono"
                        aria-label="Open command palette"
                        onclick="document.dispatchEvent(new KeyboardEvent('keydown', {key:'k', metaKey: navigator.platform.toLowerCase().includes('mac'), ctrlKey: !navigator.platform.toLowerCase().includes('mac')}))"
                    >
                        <span>⌘</span>
                        <span>K</span>
                    </button>
                    <div class="w-px h-5 bg-[var(--line)] mx-3 hidden md:block"></div>
                    <LanguageSwitcher />
                </div>
            </nav>
        </header>

        <main>
            <slot />
        </main>

        <Footer />
        <ScrollToTop />
        <CommandPalette commands={cmdkCommands} />
        <KeyboardHelp />
        <Lightbox />
        <VisitTracker />

        <script src="/sw-register.js" defer></script>

        <!-- Lenis Smooth Scroll -->
        <script>
            import Lenis from 'lenis';
            const lenis = new Lenis({
                duration: 1.0,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                orientation: 'vertical',
                gestureOrientation: 'vertical',
                smoothWheel: true,
            });
            function raf(time: number) {
                lenis.raf(time);
                requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);
        </script>

        <!-- GSAP Scroll Animations -->
        <script>
            import { gsap } from 'gsap';
            import { ScrollTrigger } from 'gsap/ScrollTrigger';

            gsap.registerPlugin(ScrollTrigger);

            document.addEventListener('DOMContentLoaded', () => {
                const animatedElements = document.querySelectorAll('[data-animate]');

                animatedElements.forEach((element) => {
                    const animationType = element.getAttribute('data-animate');
                    const delay = element.getAttribute('data-delay') || 0;
                    const duration = element.getAttribute('data-duration') || 0.7;

                    let fromProps: gsap.TweenVars = { opacity: 0 };

                    switch (animationType) {
                        case 'fade-up':    fromProps.y = 24; break;
                        case 'fade-down':  fromProps.y = -24; break;
                        case 'fade-left':  fromProps.x = 24; break;
                        case 'fade-right': fromProps.x = -24; break;
                        case 'scale':      fromProps.scale = 0.96; break;
                        case 'blur':       fromProps.filter = 'blur(8px)'; break;
                    }

                    gsap.fromTo(element, fromProps, {
                        opacity: 1,
                        x: 0, y: 0, scale: 1,
                        filter: 'blur(0px)',
                        duration: Number(duration),
                        delay: Number(delay),
                        ease: 'power3.out',
                        scrollTrigger: {
                            trigger: element,
                            start: 'top 88%',
                            toggleActions: 'play none none none',
                        },
                    });
                });

                const staggerContainers = document.querySelectorAll('[data-stagger]');
                staggerContainers.forEach((container) => {
                    const children = container.children;
                    const staggerDelay = container.getAttribute('data-stagger') || 0.06;

                    gsap.fromTo(children,
                        { opacity: 0, y: 16 },
                        {
                            opacity: 1, y: 0,
                            duration: 0.5,
                            stagger: Number(staggerDelay),
                            ease: 'power2.out',
                            scrollTrigger: {
                                trigger: container,
                                start: 'top 85%',
                                toggleActions: 'play none none none',
                            },
                        }
                    );
                });
            });
        </script>
    </body>
</html>
